<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#111111">
<meta name="color-scheme" content="dark">
<meta name="robots" content="noindex, nofollow">
<title>Respuestas del formulario</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet">

<script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-firestore-compat.js"></script>

<style>
:root{
  color-scheme: dark;
  --rojo:#9B1B30;
  --rojo-dark:#7A1526;
  --dorado:#D4A017;
  --verde:#2E7D32;
  --bg:#0E0E0E;
  --bg2:#181818;
  --bg3:#222222;
  --card:#1E1E1E;
  --borde:rgba(255,255,255,.08);
  --txt:#F5F5F5;
  --txt2:#A0A0A0;
  --txt3:#606060;
  --header-h:56px;
  --radius:16px;
  --shadow:0 4px 20px rgba(0,0,0,.45);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{
  height:100%;background:var(--bg);color:var(--txt);font-family:'Nunito',sans-serif;
  overflow:hidden;position:fixed;inset:0;width:100%;
}
button{font-family:'Nunito',sans-serif;cursor:pointer;border:none;outline:none;color:inherit;background:none}
input{font-family:'Nunito',sans-serif;outline:none;border:none;color:var(--txt);background-color:transparent;color-scheme:dark}
a{color:inherit;text-decoration:none}

/* ══════════════════════════════════════
   LOGIN — mismo patrón que pedidos.html
══════════════════════════════════════ */
#loginScreen{
  position:fixed;inset:0;background:var(--bg);
  display:flex;align-items:center;justify-content:center;padding:24px;z-index:1000;
}
.login-box{
  width:100%;max-width:360px;background:var(--card);border-radius:24px;
  padding:36px 28px 32px;box-shadow:0 12px 48px rgba(0,0,0,.6);
}
.login-logo{text-align:center;margin-bottom:28px}
.login-logo svg{width:44px;height:44px;color:var(--rojo)}
.login-logo h1{
  font-family:'Barlow Condensed',sans-serif;font-size:24px;font-weight:800;
  letter-spacing:.5px;margin-top:10px;color:var(--txt);
}
.login-logo p{font-size:13px;color:var(--txt2);margin-top:4px}
.login-field{margin-bottom:14px}
.login-field label{
  display:block;font-size:12px;font-weight:700;color:var(--txt2);
  margin-bottom:6px;letter-spacing:.5px;text-transform:uppercase;
}
.login-field input{
  width:100%;background:var(--bg3);border:1.5px solid var(--borde);border-radius:10px;
  padding:13px 14px;font-size:15px;color:var(--txt);transition:border-color .2s;
}
.login-field input:focus{border-color:var(--rojo)}
.login-err{font-size:13px;color:#EF5350;font-weight:700;text-align:center;margin-bottom:12px;min-height:18px}
.btn-login{
  width:100%;padding:15px;border-radius:12px;background:var(--rojo);color:#fff;
  font-size:16px;font-weight:800;letter-spacing:.5px;transition:opacity .15s,transform .1s;
}
.btn-login:active{opacity:.85;transform:scale(.98)}
.btn-login:disabled{opacity:.5;pointer-events:none}

.oculto{display:none !important}

/* ══════════════════════════════════════
   LAYOUT PRINCIPAL
══════════════════════════════════════ */
#app{display:flex;flex-direction:column;position:fixed;inset:0;max-width:640px;margin:0 auto;overflow:hidden}

#header{
  flex-shrink:0;height:var(--header-h);background:var(--bg2);border-bottom:1px solid var(--borde);
  display:flex;align-items:center;padding:0 16px;gap:10px;
}
.h-tit{font-family:'Barlow Condensed',sans-serif;font-size:19px;font-weight:800;flex:1}
.h-cont{
  background:var(--bg3);border-radius:20px;padding:5px 12px;font-size:12.5px;font-weight:800;color:var(--txt2);
}
.h-logout{
  width:36px;height:36px;border-radius:10px;background:var(--bg3);
  display:flex;align-items:center;justify-content:center;color:var(--txt2);
}
.h-logout svg{width:18px;height:18px}

/* ══════════════════════════════════════
   LISTA
══════════════════════════════════════ */
#lista{flex:1;overflow-y:auto;padding:14px 14px 30px;-webkit-overflow-scrolling:touch}
.vacio{
  text-align:center;padding:60px 24px;color:var(--txt3);
}
.vacio-ico{font-size:38px;margin-bottom:14px}
.vacio h3{font-size:16px;color:var(--txt2);margin-bottom:6px;font-family:'Barlow Condensed',sans-serif}
.vacio p{font-size:13.5px;line-height:1.5}

.resp-card{
  background:var(--card);border-radius:var(--radius);padding:16px 16px 14px;
  margin-bottom:11px;border:1px solid var(--borde);position:relative;
}
.resp-card.nueva{border-color:rgba(212,160,23,.4)}
.resp-card-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:8px}
.resp-nombre{font-family:'Barlow Condensed',sans-serif;font-size:18px;font-weight:800;color:var(--txt)}
.resp-badge-nueva{
  flex-shrink:0;background:var(--dorado);color:#241A05;font-size:10.5px;font-weight:900;
  padding:3px 9px;border-radius:20px;letter-spacing:.3px;
}
.resp-meta{display:flex;gap:12px;flex-wrap:wrap;font-size:12.5px;color:var(--txt2);font-weight:700;margin-bottom:10px}
.resp-meta span{display:flex;align-items:center;gap:4px}
.resp-preview{font-size:13px;color:var(--txt3);line-height:1.4}

/* ══════════════════════════════════════
   DRAWER DE DETALLE
══════════════════════════════════════ */
#detalle{
  position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.6);
  display:flex;align-items:flex-end;
}
#detalle.oculto{display:none}
.det-panel{
  width:100%;max-height:88vh;background:var(--bg2);border-radius:24px 24px 0 0;
  display:flex;flex-direction:column;animation:subir .25s ease;
}
@keyframes subir{from{transform:translateY(100%)}to{transform:translateY(0)}}
.det-handle{width:40px;height:4px;background:var(--txt3);border-radius:99px;margin:12px auto}
.det-head{display:flex;justify-content:space-between;align-items:center;padding:4px 20px 16px;border-bottom:1px solid var(--borde)}
.det-head h2{font-family:'Barlow Condensed',sans-serif;font-size:21px}
.det-close{width:34px;height:34px;border-radius:10px;background:var(--bg3);display:flex;align-items:center;justify-content:center;color:var(--txt2)}
.det-body{flex:1;overflow-y:auto;padding:18px 20px 30px;-webkit-overflow-scrolling:touch}
.det-section{margin-bottom:22px}
.det-section-tit{font-size:11.5px;font-weight:800;color:var(--txt3);text-transform:uppercase;letter-spacing:.6px;margin-bottom:10px}
.det-row{display:flex;justify-content:space-between;gap:14px;padding:9px 0;border-bottom:1px solid var(--borde);font-size:14px}
.det-row:last-child{border-bottom:none}
.det-row-label{color:var(--txt2);font-weight:700;flex-shrink:0}
.det-row-val{color:var(--txt);font-weight:700;text-align:right}
.det-notas{
  background:var(--bg3);border-radius:12px;padding:14px 16px;font-size:14px;line-height:1.55;color:var(--txt);white-space:pre-wrap;
}
.det-logo{width:64px;height:64px;border-radius:14px;object-fit:cover;margin-bottom:14px;border:1px solid var(--borde)}
.det-color-chip{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:14px}
.det-color-dot{width:20px;height:20px;border-radius:50%;border:1px solid var(--borde)}
.det-actions{display:flex;gap:10px;padding:14px 20px;padding-bottom:calc(14px + env(safe-area-inset-bottom));border-top:1px solid var(--borde)}
.det-btn{
  flex:1;padding:14px;border-radius:12px;font-weight:800;font-size:14px;text-align:center;
}
.det-btn-wa{background:#25D366;color:#fff}
.det-btn-del{background:rgba(155,27,48,.15);color:var(--rojo)}

.estado-carga{
  flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--txt3);
}
.spinner{
  width:32px;height:32px;border-radius:50%;border:3px solid var(--bg3);border-top-color:var(--rojo);
  animation:girar .8s linear infinite;margin-bottom:14px;
}
@keyframes girar{to{transform:rotate(360deg)}}
</style>
</head>
<body>

<div id="loginScreen">
  <div class="login-box">
    <div class="login-logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
      </svg>
      <h1>RESPUESTAS</h1>
      <p>Formulario de negocio</p>
    </div>
    <div id="loginErr" class="login-err"></div>
    <div class="login-field">
      <label>Correo electrónico</label>
      <input type="email" id="loginEmail" placeholder="admin@tutienda.cl" autocomplete="email" inputmode="email">
    </div>
    <div class="login-field">
      <label>Contraseña</label>
      <input type="password" id="loginPass" placeholder="••••••••" autocomplete="current-password">
    </div>
    <button class="btn-login" id="btnLogin">Entrar</button>
  </div>
</div>

<div id="app" class="oculto">
  <div id="header">
    <span class="h-tit">📋 Respuestas</span>
    <span class="h-cont" id="hContador">0</span>
    <button class="h-logout" id="btnLogout" title="Cerrar sesión">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
      </svg>
    </button>
  </div>

  <div id="lista"></div>
</div>

<div id="detalle" class="oculto"></div>

<script>
const FIREBASE_CONFIG = {
  apiKey:            "AIzaSyBuzHcQezxE36F6nDJWqYsE5rOKUvQbMBM",
  authDomain:        "tienda-test-burgers.firebaseapp.com",
  projectId:         "tienda-test-burgers",
  storageBucket:     "tienda-test-burgers.firebasestorage.app",
  messagingSenderId: "406623629835",
  appId:             "1:406623629835:web:31152eac803ed8c679cd0e"
};
let STORE_ID = "test-burgers"; // valor por defecto — se resuelve por dominio en initFirebase()

let db, auth;
let _respuestas = [];
let _unsubRespuestas = null;
let _detActual = null;

function qs(sel){ return document.querySelector(sel); }
function esc(s){ return String(s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

const RUBRO_LABELS = {
  hamburguesas:"🍔 Hamburguesas", "comida-rapida":"🌭 Comida rápida", cafeteria:"☕ Cafetería",
  pasteleria:"🧁 Pastelería", ropa:"👕 Ropa y accesorios", belleza:"💅 Belleza y estética",
  servicios:"📅 Servicios y reservas", otro:"🏪 Otro rubro"
};

/* ══════════════════════════════════════════════════════════════
   FIREBASE + AUTH
══════════════════════════════════════════════════════════════ */
async function initFirebase(){
  if (!firebase.apps.length) firebase.initializeApp(FIREBASE_CONFIG);
  db = firebase.firestore();
  auth = firebase.auth();
  auth.setPersistence(firebase.auth.Auth.Persistence.LOCAL);

  /* Resolución de STORE_ID por dominio — mismo mecanismo que los
     demás archivos. Sin fila registrada, se queda con el valor por
     defecto, nunca rompe el panel actual. */
  try {
    const domDoc = await db.collection("dominios").doc(location.hostname).get();
    if (domDoc.exists && domDoc.data().storeId) {
      STORE_ID = domDoc.data().storeId;
    }
  } catch(e) {
    console.warn("No se pudo resolver STORE_ID por dominio, se usa el valor por defecto:", e);
  }
}

function arrancarAuth(){
  auth.onAuthStateChanged(function(user){
    if (user){
      /* Login estándar de devmode — cualquier cuenta autenticada entra.
         La protección de lo sensible (cupones, precios, caja) vive en
         index.html con la reautenticación de propietario, no acá. */
      mostrarApp();
    } else {
      mostrarLogin("");
    }
  });
}

function mostrarLogin(err){
  qs("#loginScreen").classList.remove("oculto");
  qs("#app").classList.add("oculto");
  if (err) qs("#loginErr").textContent = err;
}

function mostrarApp(){
  qs("#loginScreen").classList.add("oculto");
  qs("#app").classList.remove("oculto");
  iniciarListenerRespuestas();
}

qs("#btnLogin").addEventListener("click", function(){
  const email = qs("#loginEmail").value.trim();
  const pass  = qs("#loginPass").value;
  const err   = qs("#loginErr");
  err.textContent = "";
  if (!email || !pass){ err.textContent = "Completa los campos."; return; }
  const btn = qs("#btnLogin");
  btn.disabled = true;
  btn.textContent = "Entrando…";
  auth.signInWithEmailAndPassword(email, pass).catch(function(e){
    btn.disabled = false;
    btn.textContent = "Entrar";
    const msgs = {
      "auth/wrong-password":"Contraseña incorrecta.",
      "auth/user-not-found":"No existe esa cuenta.",
      "auth/invalid-email":"Email inválido.",
      "auth/too-many-requests":"Demasiados intentos. Espera un momento."
    };
    err.textContent = msgs[e.code] || "Error al iniciar sesión.";
  });
});
qs("#loginPass").addEventListener("keydown", function(e){
  if (e.key === "Enter") qs("#btnLogin").click();
});
qs("#btnLogout").addEventListener("click", function(){
  if (_unsubRespuestas) _unsubRespuestas();
  auth.signOut();
});

/* ══════════════════════════════════════════════════════════════
   LISTENER EN TIEMPO REAL
══════════════════════════════════════════════════════════════ */
function iniciarListenerRespuestas(){
  if (_unsubRespuestas) _unsubRespuestas();
  qs("#lista").innerHTML = '<div class="estado-carga"><div class="spinner"></div>Cargando respuestas…</div>';

  _unsubRespuestas = db.collection("tiendas").doc(STORE_ID).collection("formularios")
    .orderBy("creadoEn", "desc")
    .onSnapshot(function(snap){
      _respuestas = snap.docs.map(function(d){ return d.data(); });
      renderLista();
    }, function(e){
      console.error("Listener respuestas:", e);
      qs("#lista").innerHTML = '<div class="vacio"><div class="vacio-ico">⚠️</div><h3>No se pudo cargar</h3><p>Revisa tu conexión e intenta de nuevo.</p></div>';
    });
}

/* ══════════════════════════════════════════════════════════════
   LISTA
══════════════════════════════════════════════════════════════ */
function renderLista(){
  qs("#hContador").textContent = _respuestas.length;

  if (!_respuestas.length){
    qs("#lista").innerHTML = `
      <div class="vacio">
        <div class="vacio-ico">📋</div>
        <h3>Todavía no hay respuestas</h3>
        <p>Cuando alguien complete el formulario, va a aparecer acá en tiempo real.</p>
      </div>`;
    return;
  }

  qs("#lista").innerHTML = _respuestas.map(function(r){
    const d = r.datos || {};
    const fecha = formatearFecha(r.creadoEn);
    const rubro = RUBRO_LABELS[d.rubro] || (d.rubro === "otro" ? "🏪 " + esc(d.rubroOtro) : "");
    return `
      <div class="resp-card ${!r.revisado ? 'nueva' : ''}" data-id="${esc(r.id)}">
        <div class="resp-card-top">
          <span class="resp-nombre">${esc(d.nombreNegocio || "Sin nombre")}</span>
          ${!r.revisado ? '<span class="resp-badge-nueva">NUEVA</span>' : ''}
        </div>
        <div class="resp-meta">
          <span>${rubro}</span>
          <span>🕐 ${fecha}</span>
        </div>
        ${d.whatsapp ? `<div class="resp-preview">📱 ${esc(d.whatsapp)}</div>` : ''}
      </div>
    `;
  }).join("");

  document.querySelectorAll(".resp-card").forEach(function(card){
    card.addEventListener("click", function(){
      abrirDetalle(card.dataset.id);
    });
  });
}

function formatearFecha(iso){
  if (!iso) return "";
  const f = new Date(iso);
  const ahora = new Date();
  const esHoy = f.toDateString() === ahora.toDateString();
  const horaTxt = f.toLocaleTimeString("es-CL", {hour:"2-digit", minute:"2-digit"});
  if (esHoy) return "Hoy, " + horaTxt;
  return f.toLocaleDateString("es-CL", {day:"numeric", month:"short"}) + ", " + horaTxt;
}

/* ══════════════════════════════════════════════════════════════
   DETALLE
══════════════════════════════════════════════════════════════ */
function abrirDetalle(id){
  const r = _respuestas.find(function(x){ return x.id === id; });
  if (!r) return;
  _detActual = r;
  renderDetalle();
  qs("#detalle").classList.remove("oculto");
  document.body.style.overflow = "hidden";

  // Marcar como revisado al abrir (sin bloquear el render)
  if (!r.revisado){
    db.doc("tiendas/" + STORE_ID + "/formularios/" + id).set({ revisado: true }, { merge: true }).catch(function(){});
  }
}

function cerrarDetalle(){
  qs("#detalle").classList.add("oculto");
  document.body.style.overflow = "";
  _detActual = null;
}

function renderDetalle(){
  if (!_detActual) return;
  const r = _detActual;
  const d = r.datos || {};
  const rubro = RUBRO_LABELS[d.rubro] || (d.rubro === "otro" ? "🏪 " + esc(d.rubroOtro) : "—");
  const entrega = (d.tipoEntrega || []).map(function(t){ return t === "retiro" ? "🏪 Retiro" : "🛵 Delivery"; }).join(" + ") || "—";
  const dominio = d.tieneDominioPropio === true ? ("Sí — " + esc(d.dominioPropio || "sin especificar"))
    : d.tieneDominioPropio === false ? "No, necesita ayuda para conseguir uno"
    : "—";

  qs("#detalle").innerHTML = `
    <div class="det-panel">
      <div class="det-handle"></div>
      <div class="det-head">
        <h2>${esc(d.nombreNegocio || "Sin nombre")}</h2>
        <button class="det-close" id="detClose">✕</button>
      </div>
      <div class="det-body">
        ${d.logoBase64 ? `<img src="${d.logoBase64}" class="det-logo" alt="Logo">` : ""}

        <div class="det-section">
          <div class="det-section-tit">Negocio</div>
          <div class="det-row"><span class="det-row-label">Rubro</span><span class="det-row-val">${rubro}</span></div>
          ${d.tagline ? `<div class="det-row"><span class="det-row-label">Frase</span><span class="det-row-val">${esc(d.tagline)}</span></div>` : ""}
          <div class="det-row"><span class="det-row-label">Color de marca</span><span class="det-row-val"><span class="det-color-chip"><span class="det-color-dot" style="background:${esc(d.colorPrimario || '#9B1B30')}"></span>${esc(d.colorPrimario || '—')}</span></span></div>
        </div>

        <div class="det-section">
          <div class="det-section-tit">Contacto</div>
          <div class="det-row"><span class="det-row-label">WhatsApp</span><span class="det-row-val">${esc(d.whatsapp || "—")}</span></div>
          <div class="det-row"><span class="det-row-label">Email</span><span class="det-row-val">${esc(d.emailNotif || "—")}</span></div>
        </div>

        <div class="det-section">
          <div class="det-section-tit">Entrega</div>
          <div class="det-row"><span class="det-row-label">Tipo</span><span class="det-row-val">${entrega}</span></div>
          ${d.direccionLocal ? `<div class="det-row"><span class="det-row-label">Dirección local</span><span class="det-row-val">${esc(d.direccionLocal)}</span></div>` : ""}
          ${d.comunasDelivery ? `<div class="det-row"><span class="det-row-label">Comunas</span><span class="det-row-val">${esc(d.comunasDelivery)}</span></div>` : ""}
        </div>

        <div class="det-section">
          <div class="det-section-tit">Dominio</div>
          <div class="det-row"><span class="det-row-label">¿Tiene uno?</span><span class="det-row-val">${dominio}</span></div>
        </div>

        ${d.notasAdicionales ? `
        <div class="det-section">
          <div class="det-section-tit">Notas adicionales</div>
          <div class="det-notas">${esc(d.notasAdicionales)}</div>
        </div>` : ""}

        <div class="det-section">
          <div class="det-section-tit">Metadatos</div>
          <div class="det-row"><span class="det-row-label">ID</span><span class="det-row-val" style="font-family:monospace;font-size:12px">${esc(r.id)}</span></div>
          <div class="det-row"><span class="det-row-label">Recibido</span><span class="det-row-val">${formatearFecha(r.creadoEn)}</span></div>
        </div>
      </div>
      <div class="det-actions">
        ${d.whatsapp ? `<a href="https://wa.me/${esc((d.whatsapp||'').replace(/\\D/g,''))}" target="_blank" rel="noopener" class="det-btn det-btn-wa">💬 Escribir por WhatsApp</a>` : ""}
        <button class="det-btn det-btn-del" id="detEliminar">🗑️ Eliminar</button>
      </div>
    </div>
  `;

  qs("#detClose").addEventListener("click", cerrarDetalle);
  qs("#detEliminar").addEventListener("click", function(){
    if (!confirm("¿Eliminar esta respuesta? Esta acción no se puede deshacer.")) return;
    db.doc("tiendas/" + STORE_ID + "/formularios/" + r.id).delete()
      .then(cerrarDetalle)
      .catch(function(e){ alert("No se pudo eliminar: " + e.message); });
  });
}

qs("#detalle").addEventListener("click", function(e){
  if (e.target.id === "detalle") cerrarDetalle(); // click en el fondo oscuro cierra
});

/* ══════════════════════════════════════════════════════════════
   ARRANQUE
══════════════════════════════════════════════════════════════ */
initFirebase().then(arrancarAuth);
</script>

</body>
</html>
