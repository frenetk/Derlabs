.dir-chip{flex:none;display:flex;flex-direction:column;align-items:flex-start;gap:1px;max-width:230px;padding:10px 12px;border-radius:var(--r-sm);box-shadow:inset 0 0 0 1px var(--line-2);text-align:left}
