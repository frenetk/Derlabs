/* =====================================================================
   16. CUENTA
   ===================================================================== */
.cuenta{display:grid;gap:16px;padding-top:22px}
#cuentaLoggedOut{padding:32px 20px;border-radius:var(--r-lg);background:var(--bg-2);text-align:center}
.lo-ico{width:56px;height:56px;margin:0 auto 14px;display:grid;place-items:center;border-radius:50%;background:var(--bg)}
#cuentaLoggedOut h2{font-size:20px;font-weight:700;letter-spacing:-.025em}
#cuentaLoggedOut p{max-width:36ch;margin:8px auto 20px;font-size:14px;color:var(--ink-2)}
#cuentaLoggedIn>*+*{margin-top:16px}
.profile{display:flex;align-items:center;gap:14px}
.avatar{position:relative;width:56px;height:56px;flex:none;display:grid;place-items:center;border-radius:50%;background:var(--bg-2);color:var(--ink-2);overflow:hidden}
#cuentaFoto{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
#cuentaFoto:not([src]),#cuentaFoto[src=""]{display:none}
.profile-txt{flex:1;min-width:0}
#cuentaNombre{font-size:20px;font-weight:700;line-height:1.2;letter-spacing:-.025em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#cuentaEmail{font-size:14px;color:var(--ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.points-card{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;padding:20px;border-radius:var(--r-lg);background:var(--ink);color:#fff}
.points-label{font-size:13px;font-weight:600;opacity:.7}
#cuentaPuntos{display:block;margin-top:8px;font-size:40px;font-weight:800;line-height:1;letter-spacing:-.04em;font-variant-numeric:tabular-nums}
#cuentaPuntosLabel{display:block;margin-top:8px;font-size:13px;opacity:.75}
.points-card>.i{width:28px;height:28px;opacity:.5}
.card{padding:16px;border-radius:var(--r-lg);background:var(--bg-2)}
.card-title{margin-bottom:4px;font-size:15px;font-weight:700;letter-spacing:-.01em}
.mp-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--line);cursor:pointer}
.mp-row:last-child{border-bottom:0}
.mp-txt{flex:1;min-width:0;display:grid;font-size:13px;line-height:1.4;color:var(--ink-2)}
.mp-txt strong{font-size:14px;color:var(--ink)}
#cuentaSubTabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px;padding:4px;border-radius:var(--r-md);background:var(--bg-2)}
#cuentaSubTabs button{height:38px;border-radius:var(--r-sm);font-size:14px;font-weight:600;color:var(--ink-2);text-align:center;transition:background-color .15s,color .15s}
#cuentaSubTabs button:is(.active,.sel,[aria-selected="true"]){background:var(--bg);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.08)}
.ct-sec{display:none}
.ct-sec.active{display:block}
.ct-top{display:flex;justify-content:flex-end;padding-top:12px}
.order-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 12px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line);cursor:pointer}
.order-row strong{font-size:15px;font-variant-numeric:tabular-nums}
.order-meta{font-size:13px;line-height:1.4;color:var(--ink-2)}
.order-side{grid-column:2;grid-row:1/span 2;display:grid;justify-items:end;gap:6px}
.order-total{font-weight:700;font-variant-numeric:tabular-nums}
.addr{display:flex;align-items:flex-start;gap:12px;padding:14px 0;border-bottom:1px solid var(--line)}
.addr>.i{margin-top:2px;color:var(--ink-2)}
.addr-body{flex:1;min-width:0}
.addr-name{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:700}
.addr-text{font-size:13px;line-height:1.4;color:var(--ink-2)}
.empty{display:none;padding:32px 16px;text-align:center;font-size:14px;color:var(--ink-2)}
.empty .i{width:28px;height:28px;margin:0 auto 10px;color:var(--ink-3)}
.empty strong{display:block;margin-bottom:4px;font-size:15px;color:var(--ink)}
.empty .btn{margin-top:14px}
#histLista:empty+#histVacio,#dirLista:empty+#dirVacio,#pagosHistorial:empty+#pagosVacio,#zonasList:empty+#zonasEmptyNote{display:block}

/* =====================================================================
   17. TABBAR (abajo en móvil, links centrados en la barra en escritorio)
   ===================================================================== */
.tabbar{position:fixed;left:0;right:0;bottom:0;z-index:40;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));height:calc(var(--tab-h) + var(--safe-b));padding-bottom:var(--safe-b);background:rgba(255,255,255,.9);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);border-top:1px solid var(--line)}
.tab{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:11px;font-weight:600;color:var(--ink-3);transition:color .15s}
.tab .i{width:22px;height:22px}
.tab.active{color:var(--accent)}
#btnFloat{position:fixed;z-index:39;right:16px;bottom:calc(var(--tab-h) + var(--safe-b) + 14px);display:none;align-items:center;gap:8px;height:48px;padding:0 18px;border-radius:var(--r-md);background:var(--ink);color:#fff;font-size:15px;font-weight:700;box-shadow:0 10px 28px rgba(0,0,0,.2)}
#btnFloat:hover{background:#000}
body:has(#page-inicio.active) #btnFloat{display:inline-flex}
@media (max-width:1023.98px){
  body:has(:is(#page-producto,#page-checkout).active) .tabbar{display:none}
  body:has(:is(#page-producto,#page-checkout).active) main{padding-bottom:0}
}
@media (min-width:1024px){
  .tabbar{top:var(--safe-t);bottom:auto;left:50%;right:auto;z-index:55;display:flex;gap:2px;height:var(--nav-h);padding:0;background:none;border:0;-webkit-backdrop-filter:none;backdrop-filter:none;transform:translateX(-50%)}
  .tab{flex-direction:row;padding:0 14px;font-size:14px;color:var(--ink-2)}
  .tab .i{display:none}
  .tab:hover{color:var(--ink)}
  .tab.active{color:var(--ink);box-shadow:inset 0 -2px 0 var(--ink)}
  main{padding-bottom:40px}
  #btnFloat{right:24px;bottom:24px}
}

/* =====================================================================
   18. TOAST
   ===================================================================== */
