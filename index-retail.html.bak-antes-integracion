.dir-chip span{max-width:100%;font-size:12px;color:var(--ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dir-chip:is(.active,.sel,.selected){background:var(--accent-soft);box-shadow:inset 0 0 0 2px var(--accent)}
.dir-chip-new{flex-direction:row;align-items:center;gap:6px;color:var(--accent);font-size:13px;font-weight:700}
#zonaBadge{display:flex;align-items:center;gap:8px;margin:-2px 0 14px;padding:10px 12px;border-radius:var(--r-sm);background:var(--bg-2);color:var(--ink);font-size:13px;font-weight:600;line-height:1.35}
#zonaBadge::before{content:"";width:18px;height:18px;flex:none;background:currentColor;-webkit-mask:var(--ico-truck) center/contain no-repeat;mask:var(--ico-truck) center/contain no-repeat}
#zonaBadge:empty{display:none}
#zonaBadge:is(.ok,.valida,.success){background:var(--ok-soft);color:var(--ok)}
#zonaBadge:is(.err,.error,.fuera,.invalida){background:var(--danger-soft);color:var(--danger)}
#ckMapa{position:relative;height:168px;margin-bottom:14px;border-radius:var(--r-md);background:var(--bg-2);overflow:hidden}
#ckMapa:empty,.map-demo{background:
  linear-gradient(0deg,transparent 46%,#fff 46%,#fff 53%,transparent 53%),
  linear-gradient(90deg,transparent 29%,#fff 29%,#fff 33%,transparent 33%),
  linear-gradient(90deg,transparent 71%,#fff 71%,#fff 74%,transparent 74%),
  linear-gradient(0deg,transparent 16%,#fff 16%,#fff 19%,transparent 19%),
  linear-gradient(0deg,transparent 80%,#fff 80%,#fff 83%,transparent 83%),
  linear-gradient(32deg,transparent 49%,#fff 49%,#fff 51.5%,transparent 51.5%),
  radial-gradient(circle at 86% 28%,#DCEBDD 0 13%,transparent 13.5%),
  #ECEEF1}
#ckMapa:empty::after,.map-demo::after{content:"";position:absolute;left:50%;top:50%;width:16px;height:16px;margin:-8px 0 0 -8px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 6px var(--accent-ring),0 2px 6px rgba(0,0,0,.25);border:2px solid #fff}
.pay-opts{display:grid;gap:10px;padding-bottom:12px}
.pay-opt{display:flex;align-items:center;gap:12px;padding:14px;border-radius:var(--r-md);box-shadow:inset 0 0 0 1px var(--line-2);cursor:pointer;transition:box-shadow .15s,background-color .15s}
.pay-opt:hover{box-shadow:inset 0 0 0 1px var(--ink)}
.pay-opt:has(input:checked){background:var(--accent-soft);box-shadow:inset 0 0 0 2px var(--accent)}
.pay-body{flex:1;min-width:0;display:grid;gap:1px}
.pay-title{font-size:14px;font-weight:700}
.pay-sub{font-size:12px;color:var(--ink-2)}
.pay-ico{width:40px;height:30px;flex:none;display:grid;place-items:center;border-radius:var(--r-xs);background:var(--bg);box-shadow:inset 0 0 0 1px var(--line)}
.pay-note{padding:12px 14px;border-radius:var(--r-sm);background:var(--bg-2);font-size:13px;line-height:1.45;color:var(--ink-2)}
.pay-note .ffield{margin:10px 0 0}
#pagoEfectivoNote{display:none}
.pay-opts:has(input[value="efectivo"]:checked) #pagoEfectivoNote{display:block}
.pay-opts:has(input[value="efectivo"]:checked) #pagoMPNote{display:none}
#ckResumen{align-self:start;border-radius:var(--r-lg);background:var(--bg);overflow:hidden}
#ckHandle{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;padding:18px 20px;text-align:left}
.ck-handle-l{display:flex;align-items:center;gap:8px;font-size:16px;font-weight:700;letter-spacing:-.015em}
.ck-handle-l .i{color:var(--ink-2);transition:transform .2s var(--ease)}
.ck-handle-r{display:grid;justify-items:end;gap:2px}
.ck-handle-r small{font-size:12px;font-weight:600;color:var(--ink-2)}
#ckTotal{font-size:24px}
#ckResumenBody{padding:0 20px 4px;border-top:1px solid var(--line)}
#ckResumen:is(.collapsed,.closed,.cerrado) #ckResumenBody,#ckResumenBody:is(.collapsed,.closed,.cerrado){display:none}
#ckResumen:is(.collapsed,.closed,.cerrado) .ck-handle-l .i{transform:rotate(-90deg)}
.ck-item{display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}
.ck-item .thumb .qn{position:absolute;top:-1px;right:-1px;z-index:1;min-width:18px;height:18px;padding:0 4px;border-radius:0 0 0 6px;background:var(--ink);color:#fff;font-size:11px;font-weight:800;line-height:18px;text-align:center}
.ck-item-name{font-size:13px;font-weight:600;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.ck-item-sub{font-size:12px;color:var(--ink-2)}
.ck-item-price{font-size:14px;font-weight:700;font-variant-numeric:tabular-nums}
#cupApply{padding:14px 0;border-bottom:1px solid var(--line)}
.cup-row-in{display:flex;align-items:center;gap:8px}
#fCupon{flex:1;min-width:0;height:44px;padding:0 12px;border:1px solid var(--line-2);border-radius:var(--r-sm);background:var(--bg);font-size:16px;font-weight:600;text-transform:uppercase;letter-spacing:.04em}
#fCupon::placeholder{text-transform:none;letter-spacing:0;font-weight:500}
#fCupon:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-ring)}
#btnAplicarCupon{height:44px}
#cupAplicadoRow .cup-row-in{padding:10px 12px;border-radius:var(--r-sm);background:var(--ok-soft);color:var(--ok);font-size:13px;font-weight:600}
#cupAplicadoCode{font-weight:800;letter-spacing:.04em}
#btnQuitarCupon{margin-left:auto;font-size:13px;font-weight:700;color:var(--ink);text-decoration:underline;text-underline-offset:3px}
#cupMsg{margin-top:8px;font-size:12px;font-weight:600;color:var(--ink-2)}
#cupMsg:empty{display:none}
#cupMsg:is(.ok,.success,.exito){color:var(--ok)}
#cupMsg:is(.error,.err,.invalid){color:var(--danger)}
.ck-totals{padding:12px 0 10px}
#ckLineaDesc b,#ckDescCode{color:var(--ok)}
#ckDescCode{font-weight:700}
#ckFree{margin-top:10px}
.ck-confirm{padding:14px 20px 20px;border-top:1px solid var(--line)}
.ck-secure{display:flex;align-items:center;justify-content:center;gap:6px;margin-top:12px;font-size:12px;color:var(--ink-2)}
@media (min-width:1024px){
  .ck-layout{grid-template-columns:minmax(0,1fr) 390px;gap:24px;align-items:start}
  .ck-sec{padding:24px 24px 10px}
  #ckResumen{position:sticky;top:calc(var(--nav-h) + 20px)}
}

/* =====================================================================
   13. CONFIRMACIÓN
   ===================================================================== */
.conf{max-width:600px;margin:0 auto;padding:36px 0 8px;text-align:center}
#confCheck{width:72px;height:72px;margin:0 auto;display:grid;place-items:center;border-radius:50%;background:var(--ok);color:#fff}
#confCheck .i{width:34px;height:34px;stroke-width:2.4}
#page-confirmacion.active #confCheck{animation:conf-pop .55s var(--ease) .05s both}
#page-confirmacion.active #confCheck path{stroke-dasharray:24;stroke-dashoffset:24;animation:conf-draw .45s var(--ease) .35s forwards}
@keyframes conf-pop{0%{transform:scale(.6);opacity:0}60%{transform:scale(1.06);opacity:1}100%{transform:scale(1);opacity:1}}
@keyframes conf-draw{to{stroke-dashoffset:0}}
#confTitulo{margin-top:22px;font-size:28px;font-weight:700;line-height:1.15;letter-spacing:-.035em;text-wrap:balance}
#confSub{max-width:44ch;margin:10px auto 0;font-size:15px;color:var(--ink-2);text-wrap:pretty}
.conf-num{display:inline-flex;align-items:center;gap:10px;margin-top:20px;padding:10px 16px;border-radius:var(--r-sm);background:var(--bg-2);font-size:14px;color:var(--ink-2)}
#confNum{font-size:16px;font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums;letter-spacing:.01em}
.tl{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));text-align:center}
#confTimeline{margin-top:34px}
.tl li{position:relative;padding-top:28px;font-size:12px;font-weight:600;line-height:1.3;color:var(--ink-3)}
.tl li::before{content:"";position:absolute;z-index:1;top:3px;left:50%;width:14px;height:14px;margin-left:-7px;border-radius:50%;background:var(--bg);box-shadow:inset 0 0 0 2px var(--line-2)}
.tl li::after{content:"";position:absolute;top:9px;left:-50%;right:50%;height:2px;background:var(--line-2)}
.tl li:first-child::after{display:none}
.tl li:is(.done,.ok,.completed,.completo,.listo){color:var(--ink)}
.tl li:is(.done,.ok,.completed,.completo,.listo)::before{background:var(--ink);box-shadow:none}
.tl li:is(.done,.ok,.completed,.completo,.listo,.active,.on,.current,.actual)::after{background:var(--ink)}
.tl li:is(.active,.on,.current,.actual){color:var(--accent)}
.tl li:is(.active,.on,.current,.actual)::before{background:var(--accent);box-shadow:0 0 0 4px var(--accent-ring)}
.tl-time{display:block;margin-top:2px;font-size:11px;font-weight:500;color:var(--ink-3)}
#gpsCard{margin-top:28px;text-align:left}
.gps-in{display:flex;align-items:center;gap:14px;padding:14px;border-radius:var(--r-lg);background:var(--bg-2)}
.gps-map{position:relative;width:64px;height:64px;flex:none;border-radius:var(--r-sm);overflow:hidden}
.gps-map.map-demo::after{width:12px;height:12px;margin:-6px 0 0 -6px;box-shadow:0 0 0 4px var(--accent-ring)}
.gps-txt{flex:1;min-width:0;display:grid;gap:2px;font-size:13px;line-height:1.4;color:var(--ink-2)}
.gps-txt strong{font-size:14px;color:var(--ink)}
.gps-live{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;color:var(--ok)}
.gps-live::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
#confResumen{margin-top:16px;padding:4px 16px;border-radius:var(--r-lg);background:var(--bg-2);text-align:left}
#confResumen>:last-child{border-bottom:0}
.cr-row{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid var(--line);font-size:14px}
.cr-row:last-child{border-bottom:0}
.cr-row span{color:var(--ink-2)}
.cr-row b{font-weight:600;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.cr-total span{color:var(--ink);font-weight:700}
.cr-total b{font-size:17px;font-weight:800}
.cr-block{padding:12px 0;border-bottom:1px solid var(--line);font-size:13px;line-height:1.45;color:var(--ink-2)}
.cr-block strong{display:block;margin-bottom:2px;font-size:14px;color:var(--ink)}
.conf-actions{display:grid;gap:10px;margin-top:24px}
@media (min-width:560px){.conf-actions{grid-template-columns:repeat(2,minmax(0,1fr))}}

/* =====================================================================
   14. CUPONES
   ===================================================================== */
#cuponesList{display:grid;grid-template-columns:minmax(0,1fr);gap:12px}
@media (min-width:768px){#cuponesList{grid-template-columns:repeat(2,minmax(0,1fr))}}
.cupon{display:grid;grid-template-columns:100px minmax(0,1fr);border-radius:var(--r-lg);background:var(--bg-2);overflow:hidden}
