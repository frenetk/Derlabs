.seg-btn:hover{box-shadow:inset 0 0 0 1px var(--ink)}
.seg-btn:is(.active,.sel,.selected,.on,[aria-pressed="true"]){background:var(--accent-soft);box-shadow:inset 0 0 0 2px var(--accent)}
.seg-btn:is(.active,.sel,.selected,.on,[aria-pressed="true"]) .i{color:var(--accent)}
#dirSelectorWrap{margin-bottom:16px}
.dir-chips{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;margin:0 -16px;padding:2px 16px}
