.cupon-val strong{font-size:28px;font-weight:800;line-height:1;letter-spacing:-.04em}
.cupon-val strong.sm{font-size:20px;letter-spacing:-.02em}
.cupon-val span{font-size:11px;font-weight:600;line-height:1.2;opacity:.72}
.cupon-body{display:flex;flex-direction:column;gap:4px;min-width:0;padding:14px 16px}
.cupon-title{font-size:15px;font-weight:700;letter-spacing:-.01em}
.cupon-cond{font-size:13px;line-height:1.4;color:var(--ink-2)}
.cupon-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:auto;padding-top:10px}
.cupon-code{font-size:15px;font-weight:800;letter-spacing:.06em}
.cupon.used{opacity:.6}
.cupon.used .cupon-val{background:var(--ink-3)}

/* =====================================================================
   15. TIENDAS (locales)
   ===================================================================== */
#localesList{display:grid;grid-template-columns:minmax(0,1fr);gap:12px}
@media (min-width:768px){#localesList{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (min-width:1024px){#localesList{grid-template-columns:repeat(3,minmax(0,1fr))}}
.local{display:flex;flex-direction:column;gap:14px;padding:18px;border-radius:var(--r-lg);background:var(--bg-2)}
.local-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
.local-name{font-size:16px;font-weight:700;letter-spacing:-.015em}
.local-rows{display:grid;gap:8px}
.local-row{display:flex;align-items:flex-start;gap:10px;font-size:14px;line-height:1.4;color:var(--ink-2)}
.local-row .i{margin-top:1px;color:var(--ink)}
.local-actions{display:flex;gap:8px;margin-top:auto}
