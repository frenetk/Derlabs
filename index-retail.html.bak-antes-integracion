/* Botón flotante de vista previa */
.demo-nav{display:none}
body.demo .demo-nav{display:block;position:fixed;z-index:9999;left:12px;bottom:calc(var(--tab-h) + var(--safe-b) + 12px);font-size:13px}
body.demo:has(:is(#page-producto,#page-checkout):is(.active,:target,:has(:target))) .demo-nav{bottom:calc(var(--safe-b) + 84px)}
@media (min-width:1024px){body.demo .demo-nav,body.demo:has(:is(#page-producto,#page-checkout):is(.active,:target,:has(:target))) .demo-nav{left:20px;bottom:20px}}
.demo-nav summary{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 12px;border-radius:var(--r-sm);background:var(--bg);color:var(--ink);font-weight:700;list-style:none;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.14),inset 0 0 0 1px var(--line)}
.demo-nav summary::-webkit-details-marker{display:none}
.demo-nav summary::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--accent)}
.demo-nav-panel{position:absolute;left:0;bottom:44px;width:272px;max-height:min(70dvh,560px);overflow:auto;padding:8px;border-radius:var(--r-lg);background:var(--bg);box-shadow:var(--shadow-pop)}
.demo-nav-panel p{margin:12px 8px 4px;font-size:12px;font-weight:700;color:var(--ink-2)}
.demo-nav-panel p:first-child{margin-top:4px}
.demo-nav-panel a{display:block;padding:7px 8px;border-radius:6px;color:var(--ink);font-weight:500;line-height:1.3}
.demo-nav-panel a:hover{background:var(--bg-2)}
.demo-nav-note{margin:10px 4px 4px;padding:8px 10px;border-radius:6px;background:var(--bg-2);font-size:12px;line-height:1.45;color:var(--ink-2)}
