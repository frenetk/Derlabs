        );
        qs("#campoDominioPropio").style.display = datos.tieneDominioPropio === true ? "block" : "none";
        qs("#cajaSinDominio").style.display = datos.tieneDominioPropio === false ? "block" : "none";
        limpiarError("tieneDominioPropio");
      });
    });
  },
  guardar(){
    datos.dominioPropio = qs("#fDominioPropio") ? qs("#fDominioPropio").value.trim() : datos.dominioPropio;
  },
  validar(){
    return datos.tieneDominioPropio === null ? ["tieneDominioPropio"] : [];
  }
};

