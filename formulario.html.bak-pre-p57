══════════════════════════════════════════════════════════════ */
const paso4 = {
  render(){
    return `
      <h2 class="paso-tit">Cómo entregas tus pedidos</h2>
      <p class="paso-sub">Puedes elegir una o ambas opciones.</p>

      <div class="campo" id="campo-tipoEntrega">
        <div class="toggle-row">
          <div>
            <div class="toggle-row-txt">🏪 Retiro en local</div>
            <div class="toggle-row-sub">El cliente pasa a buscar su pedido</div>
          </div>
          <label class="switch">
            <input type="checkbox" id="fRetiro" ${datos.tipoEntrega.includes("retiro") ? "checked" : ""}>
            <span class="slider"></span>
          </label>
        </div>
        <div class="toggle-row">
          <div>
            <div class="toggle-row-txt">🛵 Delivery</div>
            <div class="toggle-row-sub">Envías el pedido a domicilio</div>
          </div>
          <label class="switch">
            <input type="checkbox" id="fDelivery" ${datos.tipoEntrega.includes("delivery") ? "checked" : ""}>
            <span class="slider"></span>
          </label>
        </div>
        <div class="campo-error-txt">Elige al menos una forma de entrega</div>
      </div>

      <div class="campo" id="campoDireccionLocal" style="display:${datos.tipoEntrega.includes("retiro") ? "block" : "none"}">
        <label>Dirección de tu local</label>
        <input class="input" id="fDireccionLocal" placeholder="Av. Ejemplo 123, Comuna" value="${esc(datos.direccionLocal)}">
      </div>

      <div class="campo" id="campoComunas" style="display:${datos.tipoEntrega.includes("delivery") ? "block" : "none"}">
        <label>¿A qué comunas haces delivery?</label>
        <textarea class="input" id="fComunas" placeholder="Ej: Providencia, Ñuñoa, Las Condes">${esc(datos.comunasDelivery)}</textarea>
        <div class="campo-ayuda">Separadas por coma. Definimos los costos exactos por zona en la instalación.</div>
      </div>
    `;
  },
  bind(){
    qs("#fRetiro").addEventListener("change", actualizarTipoEntrega);
    qs("#fDelivery").addEventListener("change", actualizarTipoEntrega);
  },
  guardar(){
    datos.direccionLocal = qs("#fDireccionLocal") ? qs("#fDireccionLocal").value.trim() : datos.direccionLocal;
    datos.comunasDelivery = qs("#fComunas") ? qs("#fComunas").value.trim() : datos.comunasDelivery;
  },
  validar(){
    return datos.tipoEntrega.length === 0 ? ["tipoEntrega"] : [];
  }
};

function actualizarTipoEntrega(){
  const seleccion = [];
  if (qs("#fRetiro").checked) seleccion.push("retiro");
  if (qs("#fDelivery").checked) seleccion.push("delivery");
  datos.tipoEntrega = seleccion;
  qs("#campoDireccionLocal").style.display = seleccion.includes("retiro") ? "block" : "none";
  qs("#campoComunas").style.display = seleccion.includes("delivery") ? "block" : "none";
  limpiarError("tipoEntrega");
}

