const PASOS = [paso1, paso2, paso3, paso4, paso5, paso6];

function guardarValoresPasoActual(){
  PASOS[pasoActual - 1].guardar();
}

/* ══════════════════════════════════════════════════════════════
   ENVÍO FINAL
   Cada visita a este formulario es una persona potencialmente nueva —
   no hay pedido ni sesión previa que identifique quién es, así que no
   existe guardado progresivo intermedio (no habría a qué documento
   volver sin pedir algún tipo de login al visitante, que es justo lo
   que este formulario evita). Solo se guarda una vez, al final,
   generando un ID propio para esa respuesta.
══════════════════════════════════════════════════════════════ */
async function enviarFormularioFinal(){
  const btn = qs("#btnSiguiente");
  const original = btn.textContent;
  btn.textContent = "Enviando…";
  btn.disabled = true;

  try {
    /* Cada envío genera su propio ID — no hay pedido ni sesión previa
       que lo identifique. Formato legible: FORM- + timestamp + 3
       caracteres al azar, para que sea fácil de referenciar a simple
       vista en la lista de respuestas sin ser adivinable en secuencia. */
    const nuevoId = "FORM-" + Date.now().toString(36).toUpperCase() +
      "-" + Math.random().toString(36).slice(2, 5).toUpperCase();

    await db.doc("tiendas/" + STORE_ID + "/formularios/" + nuevoId).set({
      id: nuevoId,
      datos: datos,
      creadoEn: new Date().toISOString(),
      revisado: false
    });

    renderFinal();
  } catch(e){
    console.error(e);
    btn.textContent = original;
    btn.disabled = false;
    alert("No pudimos enviar tu formulario. Revisa tu conexión e inténtalo de nuevo.");
  }
}

/* ══════════════════════════════════════════════════════════════
   PANTALLA FINAL
══════════════════════════════════════════════════════════════ */
function renderFinal(){
  qs("#app").innerHTML = `
    <div class="final activo">
      <div class="wrap">
        <div class="final-check">✓</div>
        <h2>¡Listo, ${esc(datos.nombreNegocio || "gracias por completarlo")}!</h2>
        <p>Recibimos tu información. La revisamos y nos pondremos en contacto contigo por WhatsApp a la brevedad.</p>

        <div class="final-info">
          <div class="final-info-tit">¿Qué sigue ahora?</div>
          <p style="margin:0">Con esto ya tenemos todo lo que necesitamos para armar tu tienda a tu medida y coordinar los siguientes pasos contigo.</p>
        </div>

        <a href="https://wa.me/56930025299?text=${encodeURIComponent("Hola, acabo de completar el formulario para mi tienda")}" target="_blank" rel="noopener" class="btn btn-primario btn-standalone">
          💬 Escribirnos por WhatsApp
        </a>
      </div>
    </div>
  `;
}

arrancar();
</script>

