/* ════════════════════════════════════════════════════════════════
   P48 — MODO OSCURO de la tienda de comida
   Se activa con <html data-tema="oscuro"> (config.temaComida = "oscuro",
   panel → Diseño de la tienda → Colores). Es solo un cambio de colores:
   no mueve ni cambia el tamaño de nada.

   Cómo funciona:
   · Los colores oscuros son las variables --o-* y solo existen dentro de
     las partes que ve el cliente (lista de abajo). Cada regla dice
     var(--o-algo, color-de-siempre): fuera de esas partes (panel de
     administración, barra DEV, etc.) la variable no existe y queda el
     color de siempre. Por eso el panel sigue claro.
   · Los textos, íconos y bordes que en la tienda clara van con el color de
     la marca (precios, nombre de la tienda, enlaces, borde de los botones
     de contorno) van en dorado: --o-marca. Los botones rellenos conservan
     el color de la marca.
   · La parte 1 repite las reglas de color de la tienda, en el mismo orden,
     cambiando solo los colores. La parte 2 son retoques a mano.
   Si el navegador es muy antiguo y no entiende :is(), no se aplica nada
   y la tienda se ve clara, como siempre.
   ════════════════════════════════════════════════════════════════ */
@supports selector(:is(a, b)){
html[data-tema="oscuro"] :where(.wrapper,#btnFloat,#tabbar,#cartSheet,#cookiesModal,#dirModal,#cliPedModal,#toast,.gp-drop,.vt-hoja,#vtAyuda,#pdBar,#splashScreen){
  color-scheme:dark;
  --o-fondo:#0D0D0D;--o-sup:#1B1B1B;--o-sup2:#262626;--o-sup3:#3D3D3D;
  --o-linea:#2E2E2E;--o-linea2:#4A4A4A;
  --o-txt:#F5F5F5;--o-txt2:#A6A6A6;--o-txt3:#909090;
  --o-vidrio:rgba(13,13,13,.94);
  --o-a1:rgba(255,255,255,.06);--o-a2:rgba(255,255,255,.09);--o-a3:rgba(255,255,255,.15);--o-a4:rgba(255,255,255,.22);
  --o-marca:#DDB65B;--o-sobre:var(--osc-marca-sobre,#FFFFFF);
  --o-c-verde:#7DDB9C;--o-c-azul:#8FBCFF;--o-c-rojo:#FF9A9A;--o-c-ambar:#FFBE6B;--o-c-morado:#D6ACF7;
  --o-t-verde:#1D3326;--o-t-azul:#1C2B42;--o-t-rojo:#3B2020;--o-t-ambar:#3A2C13;--o-t-morado:#302244;
  --o-b-verde:rgba(125,219,156,.38);--o-b-azul:rgba(143,188,255,.38);--o-b-rojo:rgba(255,154,154,.38);--o-b-ambar:rgba(255,190,107,.38);--o-b-morado:rgba(214,172,247,.38);
  --blanco:var(--o-fondo);--crema:var(--o-sup);--texto:var(--o-txt);--muted:var(--o-txt2);--borde:var(--o-linea);
  --rojo:var(--osc-marca,#9B1B30);--rojo-h:var(--osc-marca-h,#C4273A);--rojo-texto:var(--osc-marca-sobre,#FFFFFF);
  color:var(--o-txt);
}

/* ═══ 1. Reglas de la tienda, con los colores del modo oscuro (generadas) ═══ */
[data-tema="oscuro"] body{background:var(--o-sup2,rgb(240, 240, 240));color:var(--texto)}
[data-tema="oscuro"] button{color:inherit}
[data-tema="oscuro"] input,[data-tema="oscuro"] select,[data-tema="oscuro"] textarea{color:var(--texto)}
[data-tema="oscuro"] .wrapper{background:var(--blanco)}
[data-tema="oscuro"] .pill{border:2px solid transparent}
[data-tema="oscuro"] .pill-solid{background:var(--rojo);color:var(--rojo-texto)}
[data-tema="oscuro"] .pill-outline{background:transparent;border-color:var(--o-marca,var(--rojo));color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .pill-white{background:var(--o-sup,rgb(255, 255, 255));color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .pill-gris{background:var(--o-sup2,rgb(245, 245, 245));color:var(--muted)}
[data-tema="oscuro"] .pill-outline-white{background:transparent;border-color:rgb(255, 255, 255);color:rgb(255, 255, 255)}
[data-tema="oscuro"] .pill-outline-muted{background:transparent;border-color:var(--o-linea,rgb(216, 216, 216));color:var(--o-txt2,rgb(138, 138, 138))}
[data-tema="oscuro"] .card{background:var(--o-sup,rgb(255, 255, 255))}
[data-tema="oscuro"] .vacio{color:var(--muted)}
[data-tema="oscuro"] .navbar{background:var(--o-sup,rgb(255, 255, 255))}
[data-tema="oscuro"] .nav-icon{background:none;border:none}
[data-tema="oscuro"] .logo{color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] #cartBadge{background:var(--rojo);color:var(--rojo-texto)}
[data-tema="oscuro"] #menuDrop{background:var(--o-sup,rgb(255, 255, 255))}
[data-tema="oscuro"] .mlink{background:none;border:none}
[data-tema="oscuro"] #bannerCerrada{background:var(--o-t-rojo,rgb(253, 236, 236));color:var(--o-c-rojo,rgb(138, 18, 32))}
[data-tema="oscuro"] .tabbar{background:var(--o-sup,rgb(255, 255, 255));border-top:1px solid var(--o-linea,rgb(238, 238, 238))}
[data-tema="oscuro"] .tab{background:none;border:none;color:var(--muted)}
[data-tema="oscuro"] .tab.active{color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .float-btn{background:var(--rojo);color:var(--rojo-texto);border:none}
[data-tema="oscuro"] .hero{background:var(--o-sup2,rgb(232, 228, 225))}
[data-tema="oscuro"] .hero::after{background:linear-gradient(transparent 30%, rgba(0, 0, 0, 0.78) 100%)}
[data-tema="oscuro"] .hero-badge{background:var(--crema);color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .hero-title{color:rgb(255, 255, 255)}
[data-tema="oscuro"] .hero-sub{color:rgba(255, 255, 255, 0.92)}
[data-tema="oscuro"] .club-card{background:var(--crema)}
[data-tema="oscuro"] .club-ico{background:var(--dorado);color:rgb(255, 255, 255)}
[data-tema="oscuro"] .oferta-card{background:var(--o-sup2,rgb(232, 228, 225))}
[data-tema="oscuro"] .oferta-card::after{background:linear-gradient(transparent 40%, rgba(0, 0, 0, 0.78) 100%)}
[data-tema="oscuro"] .oferta-nombre{color:rgb(255, 255, 255)}
[data-tema="oscuro"] .oferta-precio{background:var(--o-sup,rgb(255, 255, 255));color:var(--texto)}
[data-tema="oscuro"] .btn-add-circ{background:var(--rojo);color:var(--rojo-texto);border:none}
[data-tema="oscuro"] .cat-tile{background:var(--o-sup2,rgb(232, 228, 225));border:none}
[data-tema="oscuro"] .cat-tile span{color:rgb(255, 255, 255)}
[data-tema="oscuro"] .cat-tile::after{background:linear-gradient(rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0.75) 100%)}
@media (hover: hover){
[data-tema="oscuro"] .cat-tile:hover{background:var(--rojo)}
}
[data-tema="oscuro"] .cat-tile .cat-arrow{color:var(--o-marca,var(--rojo))}
@media (hover: hover){
[data-tema="oscuro"] .cat-tile:hover .cat-tile-nombre{color:rgb(255, 255, 255)}
[data-tema="oscuro"] .cat-tile:hover .cat-arrow{color:rgb(255, 255, 255)}
}
[data-tema="oscuro"] .prod-item{border-bottom:1px solid var(--o-linea,rgb(240, 240, 240))}
[data-tema="oscuro"] .prod-item:last-child{border-bottom:none}
[data-tema="oscuro"] .prod-img{background:var(--o-sup2,rgb(232, 228, 225))}
[data-tema="oscuro"] .prod-desc{color:var(--muted)}
[data-tema="oscuro"] .prod-precio{color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .filtros{background:var(--o-sup,rgb(255, 255, 255))}
[data-tema="oscuro"] .fpill{border:none;background:var(--o-sup2,rgb(245, 245, 245));color:var(--muted)}
[data-tema="oscuro"] .fpill.active{background:var(--rojo);color:var(--rojo-texto)}
[data-tema="oscuro"] #cartOverlay{background:rgba(0, 0, 0, 0.35)}
[data-tema="oscuro"] #cartSheet{background:var(--o-sup,rgb(255, 255, 255))}
[data-tema="oscuro"] .sheet-handle{background:var(--o-sup3,rgb(221, 221, 221))}
[data-tema="oscuro"] .cart-head{border-bottom:1px solid var(--borde)}
[data-tema="oscuro"] .cart-count{background:var(--o-sup2,rgb(245, 245, 245));color:var(--muted)}
[data-tema="oscuro"] .cart-close{background:none;border:none;color:var(--muted)}
[data-tema="oscuro"] .citem{border-bottom:1px solid var(--o-linea,rgb(245, 245, 245))}
[data-tema="oscuro"] .citem:last-child{border-bottom:none}
[data-tema="oscuro"] .citem-img{background:var(--o-sup2,rgb(232, 228, 225))}
[data-tema="oscuro"] .citem-var{color:var(--muted)}
[data-tema="oscuro"] .qty-ctrl{background:var(--o-sup2,rgb(245, 245, 245))}
[data-tema="oscuro"] .qty-btn{border:none;background:none;color:var(--texto)}
[data-tema="oscuro"] .qty-btn:active{background:var(--o-sup,rgb(255, 255, 255))}
[data-tema="oscuro"] .cart-foot{border-top:1px solid var(--borde);background:var(--o-sup,rgb(255, 255, 255))}
[data-tema="oscuro"] .tot-row{color:var(--muted)}
[data-tema="oscuro"] .tot-row.grande{color:var(--texto)}
[data-tema="oscuro"] .free-del{color:var(--o-c-verde,var(--verde))}
[data-tema="oscuro"] .tipo-btn{border:2px solid var(--o-marca,var(--rojo));color:var(--o-marca,var(--rojo));background:transparent}
[data-tema="oscuro"] .tipo-btn.active{background:var(--rojo);color:var(--rojo-texto)}
[data-tema="oscuro"] .ffield input,[data-tema="oscuro"] .ffield textarea,[data-tema="oscuro"] .ffield select{border:2px solid var(--o-linea,rgb(224, 224, 224));outline:none;background:var(--o-sup,rgb(255, 255, 255))}
[data-tema="oscuro"] .ffield label{color:var(--muted);background:transparent}
[data-tema="oscuro"] .ffield input:focus,[data-tema="oscuro"] .ffield textarea:focus,[data-tema="oscuro"] .ffield select:focus{border-color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .ffield input:focus + label,[data-tema="oscuro"] .ffield input:not(:placeholder-shown) + label,[data-tema="oscuro"] .ffield textarea:focus + label,[data-tema="oscuro"] .ffield textarea:not(:placeholder-shown) + label,[data-tema="oscuro"] .ffield select:focus + label,[data-tema="oscuro"] .ffield select.lleno + label{color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .ffield.error input,[data-tema="oscuro"] .ffield.error textarea,[data-tema="oscuro"] .ffield.error select{border-color:var(--o-marca,var(--rojo));background:var(--o-t-rojo,rgb(255, 248, 248))}
[data-tema="oscuro"] .ck-resumen{background:var(--crema)}
[data-tema="oscuro"] .ck-resumen-handle-label{color:var(--muted)}
[data-tema="oscuro"] .ck-resumen-handle-total{color:var(--texto)}
[data-tema="oscuro"] .ck-resumen-handle-arrow{color:var(--muted)}
[data-tema="oscuro"] .ck-items{color:var(--muted)}
[data-tema="oscuro"] #splashScreen{background:center center / cover var(--o-sup,rgb(255, 255, 255))}
[data-tema="oscuro"] #splashScreen.con-logo.sobre-tienda{background-color:rgba(18, 18, 18, 0.46)}
[data-tema="oscuro"] #splashScreen.con-logo.sobre-tienda .splash-dots span{background:var(--o-sup,rgb(255, 255, 255))}
[data-tema="oscuro"] #splashScreen.con-imagen::before{background:rgba(0, 0, 0, 0.42)}
[data-tema="oscuro"] .splash-nombre{color:rgba(255, 255, 255, 0.55)}
[data-tema="oscuro"] .splash-sub{color:rgba(255, 255, 255, 0.35)}
[data-tema="oscuro"] .splash-dots span{background:var(--splash-color,#14121f)}
[data-tema="oscuro"] .skel{background:linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.18) 50%, rgba(255, 255, 255, 0) 100%) 0% 0% / 400px 100% var(--o-a2,rgba(0, 0, 0, 0.07))}
[data-tema="oscuro"] .skel-item{border-bottom:1px solid var(--o-a1,rgba(0, 0, 0, 0.05))}
[data-tema="oscuro"] .conf-check{background:var(--verde);color:rgb(255, 255, 255)}
[data-tema="oscuro"] .conf-check.pendiente{background:rgb(245, 124, 0)}
[data-tema="oscuro"] .conf-sub{color:var(--muted)}
[data-tema="oscuro"] .conf-num{background:var(--crema);color:var(--texto)}
[data-tema="oscuro"] .conf-resumen .linea.total{border-top:1px solid var(--borde)}
[data-tema="oscuro"] .tl-step::before{background:var(--o-sup2,rgb(228, 228, 228))}
[data-tema="oscuro"] .tl-ico{background:var(--o-sup2,rgb(240, 240, 240));color:var(--o-txt3,rgb(154, 154, 154))}
[data-tema="oscuro"] .tl-step.ok .tl-ico{background:var(--verde);color:rgb(255, 255, 255)}
[data-tema="oscuro"] .tl-txt{color:var(--o-txt3,rgb(154, 154, 154))}
[data-tema="oscuro"] .tl-step.ok .tl-txt{color:var(--texto)}
[data-tema="oscuro"] .gps-card{border:2px dashed var(--o-linea2,rgb(207, 207, 207));color:var(--muted)}
[data-tema="oscuro"] .cup-cod{background:var(--o-sup2,rgb(245, 245, 245))}
[data-tema="oscuro"] .cup-desc-grande{color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .cup-detalle{color:var(--muted)}
[data-tema="oscuro"] .cup-vence{color:var(--muted)}
[data-tema="oscuro"] .btn-copiar.copiado{background:var(--verde);border-color:var(--o-c-verde,var(--verde));color:rgb(255, 255, 255)}
[data-tema="oscuro"] .local-img{background:var(--o-sup2,rgb(232, 228, 225))}
[data-tema="oscuro"] .local-dir{color:var(--muted)}
[data-tema="oscuro"] .estado-abierto{color:var(--o-c-verde,var(--verde))}
[data-tema="oscuro"] .estado-cerrado{color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .local-horario{color:var(--muted)}
[data-tema="oscuro"] .footer-cr{border-top:1px solid var(--borde);background:var(--crema)}
[data-tema="oscuro"] .cr-logo{color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .cr-texto{color:var(--muted)}
[data-tema="oscuro"] .cr-anno{color:var(--muted)}
[data-tema="oscuro"] .overlay{background:rgba(0, 0, 0, 0.4)}
[data-tema="oscuro"] .modal-card{background:var(--o-sup,rgb(255, 255, 255))}
[data-tema="oscuro"] .modal-card p{color:var(--muted)}
[data-tema="oscuro"] .field{border:2px solid var(--o-linea,rgb(230, 230, 230));outline:none}
[data-tema="oscuro"] .field:focus{border-color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .err{color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] #imgPreviewWrap{background:var(--o-sup2,rgb(245, 245, 245))}
[data-tema="oscuro"] #toast{background:rgb(26, 58, 26);color:rgb(255, 255, 255)}
[data-tema="oscuro"] #devBar{background:rgb(26, 58, 26);color:rgb(255, 255, 255)}
[data-tema="oscuro"] #devBar .db-badge{background:rgb(46, 125, 50)}
[data-tema="oscuro"] #previewChip{background:rgb(26, 58, 26);color:rgb(255, 255, 255);border:none}
@media (hover: hover){
[data-tema="oscuro"] body.dev-on:not(.preview-cliente) [data-ecol]:not(.editing):hover{outline:rgba(155, 27, 48, 0.4) dashed 2px}
[data-tema="oscuro"] body.dev-on:not(.preview-cliente) [data-ecol]:not(.editing):hover::after{background:var(--rojo);color:var(--rojo-texto)}
}
[data-tema="oscuro"] [data-ecol].editing{outline:2px solid var(--o-marca,var(--rojo))!important;background:var(--o-t-ambar,rgb(255, 253, 231))!important;color:var(--texto)!important}
[data-tema="oscuro"] #adminPanel{background:var(--o-sup,rgb(255, 255, 255))}
[data-tema="oscuro"] .panel-head{border-bottom:1px solid var(--borde)}
[data-tema="oscuro"] .panel-close{background:none;border:none}
[data-tema="oscuro"] .ptabs{border-bottom:1px solid var(--borde)}
[data-tema="oscuro"] .ptab{border:none;background:var(--o-sup2,rgb(245, 245, 245));color:var(--muted)}
[data-tema="oscuro"] .ptab.active{background:var(--rojo);color:var(--rojo-texto)}
[data-tema="oscuro"] .psec h4{color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .plabel{color:var(--o-txt2,rgb(136, 136, 136))}
[data-tema="oscuro"] .pnota{color:var(--muted)}
[data-tema="oscuro"] .prow{background:var(--o-sup,rgb(250, 250, 250))}
[data-tema="oscuro"] .prow .mini{background:var(--o-sup2,rgb(232, 228, 225))}
[data-tema="oscuro"] .prow .ttl small{color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .ibtn{border:none;background:var(--o-sup,rgb(255, 255, 255))}
[data-tema="oscuro"] .prod-editor{background:var(--o-sup,rgb(255, 255, 255));border:1.5px solid var(--borde)}
[data-tema="oscuro"] .slider{background:var(--o-sup3,rgb(216, 216, 216))}
[data-tema="oscuro"] .slider::before{background:var(--o-sup,rgb(255, 255, 255))}
[data-tema="oscuro"] .switch input:checked + .slider{background:var(--verde)}
[data-tema="oscuro"] .vpill{border:none;background:var(--crema);color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .msj-preview{background:var(--o-t-verde,rgb(232, 245, 233));color:var(--o-c-verde,rgb(27, 60, 34))}
[data-tema="oscuro"] .mp-guia{background:var(--crema);color:var(--o-txt,rgb(74, 74, 74))}
[data-tema="oscuro"] .device-row{background:var(--o-sup,rgb(250, 250, 250))}
[data-tema="oscuro"] .device-row small{color:var(--muted)}
[data-tema="oscuro"] .btn-quitar{border:none;background:none;color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .cup-admin-card{background:var(--o-sup,rgb(250, 250, 250));border:1px solid var(--borde)}
[data-tema="oscuro"] .cup-admin-valor{color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .cup-admin-sub{color:var(--muted)}
[data-tema="oscuro"] .pill-mini{background:var(--o-sup2,rgb(239, 239, 239));color:var(--texto);border:none}
[data-tema="oscuro"] .pill-mini-del{background:rgba(155, 27, 48, 0.1);color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .promo-preview-wrap{background:var(--o-sup2,rgb(244, 244, 244))}
[data-tema="oscuro"] .promo-admin-card{background:var(--o-sup,rgb(250, 250, 250));border:1px solid var(--borde)}
[data-tema="oscuro"] .promo-admin-estado{color:var(--o-c-verde,var(--verde))}
[data-tema="oscuro"] .promo-admin-estado.inactivo{color:var(--muted)}
[data-tema="oscuro"] .color-row input[type="color"]{border:none;background:none}
[data-tema="oscuro"] .pending-bar{background:var(--o-t-ambar,rgb(255, 248, 225));border-bottom:1px solid var(--o-b-ambar,rgb(255, 224, 130))}
[data-tema="oscuro"] .pending-bar #pendingCount{color:var(--o-c-ambar,rgb(138, 109, 0))}
[data-tema="oscuro"] .panel-min{background:var(--o-sup,rgb(255, 255, 255));border:1.5px solid var(--borde);color:var(--texto)}
[data-tema="oscuro"] .panel-chip{background:var(--rojo);color:var(--rojo-texto);border:none}
[data-tema="oscuro"] .ped-card{background:var(--crema);border-left:4px solid var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .ped-id{color:var(--o-marca,var(--rojo))}
[data-tema="oscuro"] .ped-time{color:var(--muted)}
[data-tema="oscuro"] .ped-items{color:var(--muted)}
[data-tema="oscuro"] .ped-badge.nuevo{background:var(--o-t-ambar,rgb(255, 243, 224));color:var(--o-c-ambar,rgb(230, 81, 0))}
[data-tema="oscuro"] .ped-badge.preparando{background:var(--o-t-azul,rgb(227, 242, 253));color:var(--o-c-azul,rgb(21, 101, 192))}
[data-tema="oscuro"] .ped-badge.camino{background:var(--o-t-morado,rgb(243, 229, 245));color:var(--o-c-morado,rgb(106, 27, 154))}
[data-tema="oscuro"] .ped-badge.entregado{background:var(--o-t-verde,rgb(232, 245, 233));color:var(--o-c-verde,rgb(46, 125, 50))}
[data-tema="oscuro"] .ped-badge.cancelado{background:var(--o-t-rojo,rgb(255, 235, 238));color:var(--o-c-rojo,rgb(198, 40, 40))}
[data-tema="oscuro"] #pedidoDetalle{background:var(--o-sup,rgb(255, 255, 255))}
[data-tema="oscuro"] .det-header{background:var(--rojo);color:var(--rojo-texto)}
[data-tema="oscuro"] .det-back{background:none;border:none;color:var(--rojo-texto)}
[data-tema="oscuro"] .det-sec{background:var(--crema)}
[data-tema="oscuro"] .det-sec h5{color:var(--muted)}
[data-tema="oscuro"] .det-row{border-bottom:1px solid var(--o-a2,rgba(0, 0, 0, 0.06))}
[data-tema="oscuro"] .det-row:last-child{border-bottom:none}
[data-tema="oscuro"] .det-lbl{color:var(--muted)}
