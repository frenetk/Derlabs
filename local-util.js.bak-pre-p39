    "⛶": "<path d=\"M8 3H5a2 2 0 0 0-2 2v3\"/><path d=\"M21 8V5a2 2 0 0 0-2-2h-3\"/><path d=\"M3 16v3a2 2 0 0 0 2 2h3\"/><path d=\"M16 21h3a2 2 0 0 0 2-2v-3\"/>",
    "🔇": "<path d=\"M11 5 6 9H2v6h4l5 4z\"/><path d=\"m22 9-6 6M16 9l6 6\"/>",
    "📝": "<path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z\"/>",
    "🧑‍🍳": "<path d=\"M17 21a1 1 0 0 0 1-1v-5.35c0-.46.32-.84.73-1.04a4 4 0 0 0-2.14-7.59 5 5 0 0 0-9.18 0 4 4 0 0 0-2.14 7.59c.41.2.73.58.73 1.04V20a1 1 0 0 0 1 1Z\"/><path d=\"M6 17h12\"/>"
  };
  var claves = Object.keys(ICONOS).sort(function(a, b){ return b.length - a.length; });
  var RE = new RegExp("(" + claves.map(function(k){ return k.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"); }).join("|") + ")", "g");
  function svg(k){ return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + ICONOS[k] + '</svg>'; }
  function tiene(t){ RE.lastIndex = 0; return RE.test(String(t).replace(/\uFE0F/g, "")); }
  function nodo(tn){
    var txt = String(tn.nodeValue).replace(/\uFE0F/g, "");
    RE.lastIndex = 0; if (!RE.test(txt)) return;
    var frag = document.createDocumentFragment(), ult = 0, m;
    RE.lastIndex = 0;
    while ((m = RE.exec(txt))){
      if (m.index > ult) frag.appendChild(document.createTextNode(txt.slice(ult, m.index)));
      var s = document.createElement("span"); s.className = "dl-ico"; s.innerHTML = svg(m[1]); frag.appendChild(s);
      ult = m.index + m[1].length;
    }
    if (ult < txt.length) frag.appendChild(document.createTextNode(txt.slice(ult)));
    tn.parentNode.replaceChild(frag, tn);
  }
  function aplicar(raiz){
    if (!raiz) return;
    if (raiz.nodeType === 3){ if (raiz.parentNode && !/^(SCRIPT|STYLE|TEXTAREA|OPTION|TITLE)$/.test(raiz.parentNode.nodeName)) nodo(raiz); return; }
    if (raiz.nodeType !== 1 || /^(SCRIPT|STYLE|TEXTAREA|SELECT)$/.test(raiz.nodeName)) return;
    var w = document.createTreeWalker(raiz, NodeFilter.SHOW_TEXT, { acceptNode: function(n){
      return /^(SCRIPT|STYLE|TEXTAREA|OPTION)$/.test(n.parentNode.nodeName) || !tiene(n.nodeValue) ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT; } });
    var lista = [], n; while ((n = w.nextNode())) lista.push(n);
    lista.forEach(nodo);
  }
  function iniciar(){
    var st = document.createElement("style");
    st.textContent = ".dl-ico{display:inline-block;width:1.2em;height:1.2em;vertical-align:-.22em;flex:none}.dl-ico svg{width:100%;height:100%;display:block}";
    document.head.appendChild(st);
    aplicar(document.body);
    new MutationObserver(function(ms){
      for (var i = 0; i < ms.length; i++){
        var m = ms[i];
        if (m.type === "characterData") aplicar(m.target);
        else for (var k = 0; k < m.addedNodes.length; k++) aplicar(m.addedNodes[k]);
      }
    }).observe(document.body, { childList: true, subtree: true, characterData: true });
  }
  var DL = window.DL = window.DL || {};
  DL.iconos = { aplicar: aplicar };
  if (document.body) iniciar(); else document.addEventListener("DOMContentLoaded", iniciar);
})();
