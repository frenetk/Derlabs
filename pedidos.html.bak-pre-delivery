   WHATSAPP
══════════════════════════════════════════════════════════════ */
function msgWhatsApp(ped){
  var cl    = ped.cliente || {};
  var nombre = cl.nombre || "cliente";
  var id    = ped.id;
  var msgs = {
    nuevo:       "Hola " + nombre + ", recibimos tu pedido " + id + " 🍔 ¡Pronto empezamos a prepararlo!",
    preparacion: "Hola " + nombre + ", estamos preparando tu pedido " + id + " 🍔",
    camino:      "Hola " + nombre + ", tu pedido " + id + " ya está en camino 🛵 ¡Llegamos pronto!",
    listo:       "Hola " + nombre + ", tu pedido " + id + " fue entregado ✅ ¡Gracias por elegirnos!"
  };
  return msgs[ped.estado] || "Hola " + nombre + ", te escribimos sobre tu pedido " + id;
}

function abrirWhatsApp(ped){
  var cl  = ped.cliente || {};
  var tel = String(cl.telefono || "").replace(/\D/g,"");
  if(!tel){ mostrarToast("Sin número de teléfono"); return; }
  if(tel.startsWith("0")) tel = tel.slice(1);
  if(!tel.startsWith("56")) tel = "56" + tel;
  var msg = encodeURIComponent(msgWhatsApp(ped));
  window.open("https://wa.me/" + tel + "?text=" + msg, "_blank");
}

/* ══════════════════════════════════════════════════════════════
   DETALLE DRAWER
══════════════════════════════════════════════════════════════ */
function abrirDetalle(ped){
  _detPedido = ped;
  renderDetalle();
  qs("#detalle").classList.remove("oculto");
  document.body.style.overflow = "hidden";
}

function cerrarDetalle(){
  qs("#detalle").classList.add("oculto");
  document.body.style.overflow = "";
  _detPedido = null;
}

function renderDetalle(){
  if(!_detPedido) return;
  var p  = _detPedido;
  var cl = p.cliente || {};

  // Header
  qs("#detId").textContent    = p.id;
  qs("#detBadge").className   = "card-badge " + badgeClass(p.estado);
  qs("#detBadge").textContent = labelEstado(p.estado);

  // Body
  var tl = p.estadoTimeline || {};
  var body = [];

  // — Cliente
  body.push('<div class="det-section">');
  body.push('<div class="det-section-tit">Cliente</div>');

  body.push(detalleRow(
    iconSVG("person"),
    "Nombre",
    esc(cl.nombre || "—")
  ));
  if(cl.telefono){
    body.push(detalleRow(
      iconSVG("phone"),
      "Teléfono",
      '<a href="tel:' + esc(cl.telefono) + '">' + esc(cl.telefono) + '</a>'
    ));
  }
  if(cl.email){
    body.push(detalleRow(
      iconSVG("mail"),
      "Email",
      esc(cl.email)
    ));
  }
  body.push('</div>');

  // — Entrega
  if(p.tipo === "delivery" && cl.direccion){
    body.push('<div class="det-section">');
    body.push('<div class="det-section-tit">Entrega</div>');
    var direccionCompleta = (cl.direccion||"") + (cl.comuna ? ", " + cl.comuna : "") + " Chile";
    var mapsUrl = "https://maps.google.com/?q=" + encodeURIComponent(direccionCompleta);
    /* Mapa en miniatura — embed de Google Maps (modo "place"), usa la
       misma GOOGLE_MAPS_KEY que ya existe en index.html para el
       autocompletado del checkout. No requiere facturación habilitada
       en Google Cloud, a diferencia de la Static Maps API. */
    var mapaEmbedUrl = "https://www.google.com/maps/embed/v1/place?key=" + GOOGLE_MAPS_KEY +
      "&q=" + encodeURIComponent(direccionCompleta);
    body.push(
      '<div class="det-mapa-mini">' +
        '<iframe src="' + mapaEmbedUrl + '" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>' +
      '</div>'
    );
    body.push(detalleRow(
      iconSVG("map"),
      "Dirección",
      '<a href="' + mapsUrl + '" target="_blank">' + esc(cl.direccion) + (cl.comuna ? ", " + esc(cl.comuna) : "") + ' 📍</a>'
    ));
    if(cl.referencias){
      body.push(detalleRow(iconSVG("note"), "Referencias", esc(cl.referencias)));
    }
    body.push('</div>');
  } else if(p.tipo === "retiro"){
    body.push('<div class="det-section"><div class="det-section-tit">Retiro en local</div></div>');
  }

  // — Productos
  body.push('<div class="det-section">');
  body.push('<div class="det-section-tit">Productos</div>');
  body.push('<div class="det-items">');
  (p.items || []).forEach(function(it){
    var extra = "";
    if(it.variantes && typeof it.variantes === "object"){
      var partesVar = [];
      for(var k in it.variantes){ if(it.variantes[k]) partesVar.push(esc(k) + ": " + esc(it.variantes[k])); }
      if(partesVar.length) extra += '<div class="det-item-extra">' + partesVar.join(" · ") + '</div>';
    }
    if(it.notaPersonal){
      extra += '<div class="det-item-extra det-item-nota">"' + esc(it.notaPersonal) + '"</div>';
    }
    body.push(
      '<div class="det-item">' +
        '<div class="det-item-cant">' + (it.cantidad||1) + '</div>' +
        '<div class="det-item-nom">' + esc(it.nombre) + extra + '</div>' +
        '<div class="det-item-precio">' + fmtPrecio((it.precio||0) * (it.cantidad||1)) + '</div>' +
      '</div>'
    );
  });
  body.push('</div>');

  // Totales
  body.push('<div class="det-totales" style="margin-top:10px">');
  body.push('<div class="det-total-row"><span>Subtotal</span><span>' + fmtPrecio(p.subtotal || p.total) + '</span></div>');
  if(p.descuento && p.descuento > 0){
    body.push('<div class="det-total-row descuento"><span>Descuento (' + esc(p.cuponAplicado) + ')</span><span>-' + fmtPrecio(p.descuento) + '</span></div>');
  }
  if(p.tipo === "delivery"){
    body.push('<div class="det-total-row"><span>Delivery</span><span>' + fmtPrecio(p.costoDelivery) + '</span></div>');
  }
  body.push('<div class="det-total-row principal"><span>Total</span><span>' + fmtPrecio(p.total) + '</span></div>');
  body.push('</div>');

  body.push('</div>'); // /section productos

  // Notas
  if(cl.notas){
    body.push('<div class="det-section">');
    body.push('<div class="det-section-tit">Notas de cocina</div>');
    body.push('<div style="font-size:14px;font-weight:600;color:var(--txt)">' + esc(cl.notas) + '</div>');
    body.push('</div>');
  }

  // Pago
  body.push('<div class="det-section">');
  body.push('<div class="det-section-tit">Pago</div>');
  body.push(detalleRow(iconSVG("card"), "Método", esc(p.metodoPago === "mercadopago" ? "MercadoPago" : "Efectivo al entregar")));
  body.push(detalleRow(iconSVG("clock"), "Pedido el", fmtFecha(p.fecha)));
  body.push('</div>');

  // Timeline
  body.push('<div class="det-section">');
  body.push('<div class="det-section-tit">Estado del pedido</div>');
  body.push('<div class="timeline">');
  var pasos = [
    { key:"nuevo",       lbl:"Pedido recibido",    ico:"✓" },
    { key:"preparacion", lbl:"En preparación",      ico:"🍔" },
    { key:"camino",      lbl:"En camino",            ico:"🛵" },
    { key:"listo",       lbl:"Entregado",            ico:"✅" }
  ];
  pasos.forEach(function(paso){
    var ts   = tl[paso.key];
    var hecho = !!ts;
    body.push(
      '<div class="tl-item">' +
        '<div class="tl-dot ' + (hecho ? "hecho" : "pendiente") + '">' +
          (hecho ? paso.ico : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/></svg>') +
        '</div>' +
        '<div class="tl-info">' +
          '<div class="tl-label">' + esc(paso.lbl) + '</div>' +
          (hecho ? '<div class="tl-ts">' + fmtFecha(ts) + '</div>' : '<div class="tl-ts">Pendiente</div>') +
        '</div>' +
      '</div>'
    );
  });
  body.push('</div></div>'); // /timeline /section

  qs("#detBody").innerHTML = body.join("");
  aplicarIconosGlobal(qs("#detBody"));

  // Acciones del drawer
  var acc = [];
  var btnTxt = btnEstadoTxt(p.estado);
  if(btnTxt){
    acc.push('<button class="btn-estado ' + btnEstadoCls(p.estado) + '" id="detBtnEstado">' + btnTxt + '</button>');
  }
  // Botón WhatsApp si hay teléfono
  if(cl.telefono){
    acc.push(
      '<button class="det-btn-wa" id="detBtnWa" aria-label="WhatsApp">' +
        '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.117 1.532 5.845L.057 23.077a.75.75 0 0 0 .924.924l5.232-1.475A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.885 0-3.64-.523-5.144-1.428l-.368-.22-3.808 1.074 1.074-3.808-.22-.368A9.945 9.945 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>' +
      '</button>'
    );
  }
  // Botón Maps si hay dirección
  if(p.tipo === "delivery" && cl.direccion){
    var mUrl = "https://maps.google.com/?q=" + encodeURIComponent((cl.direccion||"") + " " + (cl.comuna||"") + " Chile");
    acc.push(
      '<a href="' + mUrl + '" target="_blank" class="det-btn-maps" aria-label="Ver en Maps">' +
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>' +
      '</a>'
    );
  }
  // Botón eliminar — siempre disponible, con confirmación
  acc.push(
    '<button class="det-btn-eliminar" id="detBtnEliminar" aria-label="Eliminar pedido">' +
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>' +
    '</button>'
  );

  qs("#detAcciones").innerHTML = acc.join("");

  // Eventos botones del drawer
  var detBtnE = qs("#detBtnEstado");
  if(detBtnE){
    detBtnE.addEventListener("click", function(){
      avanzarEstado(_detPedido);
    });
  }
  var detBtnW = qs("#detBtnWa");
  if(detBtnW){
    detBtnW.addEventListener("click", function(){
      abrirWhatsApp(_detPedido);
    });
  }
  var detBtnDel = qs("#detBtnEliminar");
  if(detBtnDel){
    detBtnDel.addEventListener("click", function(){
      eliminarPedido(_detPedido);
    });
  }
}

function detalleRow(icoHTML, lbl, val){
  return [
    '<div class="det-row">',
      '<div class="det-row-ico">' + icoHTML + '</div>',
      '<div class="det-row-lbl">' + lbl + '</div>',
      '<div class="det-row-val">' + val + '</div>',
    '</div>'
  ].join("");
}

function iconSVG(tipo){
  var svgs = {
    person: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/></svg>',
    phone:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.8 19.8 0 0 1-3.07-8.67 2 2 0 0 1 1.99-2.18h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6 6l.86-.86a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
    mail:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>',
    map:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>',
    note:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
    card:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>',
    clock:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>'
  };
  return svgs[tipo] || "";
}

/* Cerrar detalle */
qs("#detClose").addEventListener("click", cerrarDetalle);
qs("#detOverlay").addEventListener("click", cerrarDetalle);

/* ══════════════════════════════════════════════════════════════
   TABS
══════════════════════════════════════════════════════════════ */
qs("#tabs").addEventListener("click", function(e){
  var btn = e.target.closest(".tab-btn");
  if(!btn) return;
  qs(".tab-btn.activo").classList.remove("activo");
  btn.classList.add("activo");
  _tabActiva = btn.dataset.tab;
  _busqueda  = "";
  qs("#searchInput").value = "";
  renderLista();
});

/* ══════════════════════════════════════════════════════════════
   BÚSQUEDA
══════════════════════════════════════════════════════════════ */
qs("#searchInput").addEventListener("input", function(){
  _busqueda = this.value.trim();
  renderLista();
});

/* ══════════════════════════════════════════════════════════════
   SETTINGS
══════════════════════════════════════════════════════════════ */
qs("#btnSettings").addEventListener("click", function(){
  qs("#settings").classList.remove("oculto");
});
qs("#setOverlay").addEventListener("click", function(){
  qs("#settings").classList.add("oculto");
});
qs("#togSonido").addEventListener("change", function(){
  _sonidoActivo = this.checked;
  localStorage.setItem("ped_sonido", _sonidoActivo ? "1" : "0");
});
qs("#togVibracion").addEventListener("change", function(){
  _vibracionActiva = this.checked;
  localStorage.setItem("ped_vibracion", _vibracionActiva ? "1" : "0");
});
qs("#btnLogout").addEventListener("click", function(){
  if(!confirm("¿Cerrar sesión?")) return;
  auth.signOut();
  qs("#settings").classList.add("oculto");
});

/* Restaurar preferencias */
function cargarPreferencias(){
  var s = localStorage.getItem("ped_sonido");
  var v = localStorage.getItem("ped_vibracion");
  if(s !== null){ _sonidoActivo    = s === "1"; qs("#togSonido").checked    = _sonidoActivo; }
  if(v !== null){ _vibracionActiva = v === "1"; qs("#togVibracion").checked = _vibracionActiva; }
}

/* ══════════════════════════════════════════════════════════════
   ARRANQUE
══════════════════════════════════════════════════════════════ */
initFirebase().then(function(){
  cargarPreferencias();
  arrancarAuth();
});
aplicarIconosGlobal(); // cubre el HTML estático (ej. "🔔 Notificaciones push" en Configuración)
/* Refuerzo periódico — mismo criterio que index.html: idempotente,
   cubre cualquier emoji insertado por fuera de los puntos ya
   conectados (renderLista, renderDetalle, mostrarToast) sin tener que
   identificar cada función una por una. */
setInterval(function(){ aplicarIconosGlobal(); }, 2000);

/* Repetir la limpieza cada 5 minutos mientras la pestaña quede abierta,
   no solo al cargar — así un vendedor que deja pedidos.html abierto todo
   el día igual mantiene la tienda libre de pedidos sin pagar. */
setInterval(function(){
  if(auth && auth.currentUser) limpiarPendientesVencidos();
}, 5 * 60 * 1000);

/* Activar AudioContext con primer toque del usuario (política de autoplay) */
document.addEventListener("click", function activarAudio(){
  if(!_audCtx){
    try{ _audCtx = new (window.AudioContext || window.webkitAudioContext)(); }catch(e){}
  }
  document.removeEventListener("click", activarAudio);
}, { once: true });
</script>
</body>
