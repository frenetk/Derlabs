/* Mismos ids/emoji que RUBROS en index.html, generar-tienda.html y
   formulario.html — solo el emoji hace falta acá, no el color. */
var EMOJI_POR_RUBRO = {
  "hamburguesas": "🍔", "comida-rapida": "🌭", "cafeteria": "☕",
  "pasteleria": "🧁", "ropa": "👕", "belleza": "💅",
  "servicios": "📅", "otro": "🏪"
};
/* Mismo mecanismo de favicon dinámico que index.html (ver
   aplicarFavicon()/actualizarFaviconConConfig() ahí) — duplicado acá
   porque pedidos.html es un documento HTML independiente, con su
   propio <head>, que no hereda nada de lo que index.html haga en el
   suyo. Relevante en particular porque pedidos.html es el start_url
   del acceso directo (ver manifest.json dinámico) — conviene que la
   pestaña del navegador y el ícono se sientan de la misma tienda. */
function aplicarFaviconPedidos(url){
  var link = document.querySelector('link[rel="icon"]');
  if (!link){
    link = document.createElement("link");
    link.rel = "icon";
    document.head.appendChild(link);
  }
  link.type = "image/png";
  link.href = url;
}
function aplicarFaviconEmoji(emoji){
  try {
    /* Reutiliza el mismo SVG que EMOJI_A_ICONO ya usa para reemplazar
       este emoji en el resto de la interfaz — mismo criterio que
       index.html (ver comentarios ahí para el detalle completo). */
    var svg = EMOJI_A_ICONO[emoji];
    if (!svg) { aplicarFaviconEmojiCrudo(emoji); return; }
    var canvas = document.createElement("canvas");
    canvas.width = 64; canvas.height = 64;
    var ctx = canvas.getContext("2d");
    var img = new Image();
    var svgConColor = svg.replace("<svg ", '<svg style="color:#1A1A1A" ');
    var svgUrl = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svgConColor);
    img.onload = function(){
      ctx.drawImage(img, 6, 6, 52, 52);
      aplicarFaviconPedidos(canvas.toDataURL("image/png"));
    };
    img.onerror = function(){ aplicarFaviconEmojiCrudo(emoji); };
    img.src = svgUrl;
  } catch(e){ console.warn("No se pudo generar el favicon:", e); }
}
function aplicarFaviconEmojiCrudo(emoji){
  try {
    var canvas = document.createElement("canvas");
    canvas.width = 64; canvas.height = 64;
    var ctx = canvas.getContext("2d");
    ctx.font = "52px sans-serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(emoji, 32, 38);
    aplicarFaviconPedidos(canvas.toDataURL("image/png"));
  } catch(e){ console.warn("No se pudo generar el favicon de respaldo:", e); }
}
function cargarNombreTienda(){
  db.collection("tiendas").doc(STORE_ID)
    .collection("config").doc("general")
    .get().then(function(doc){
      if(doc.exists){
        var d = doc.data();
        var nombre = d.nombreTienda || d.nombre || "Pedidos";
        qs("#hTiendaNombre").textContent = nombre;
        document.title = nombre + " — Pedidos";
        /* Prioridad: logo real del cliente > emoji del rubro > nada
           (queda el ícono por defecto del navegador). */
        if (d.logoBase64) aplicarFaviconPedidos(d.logoBase64);
        else aplicarFaviconEmoji(EMOJI_POR_RUBRO[d.rubro] || EMOJI_POR_RUBRO.otro);
      }
    }).catch(function(){});
}

/* ══════════════════════════════════════════════════════════════
   LISTENER EN TIEMPO REAL
══════════════════════════════════════════════════════════════ */
function iniciarListenerPedidos(){
  if(_unsubPedidos) _unsubPedidos();

  // Escuchar últimas 48h
  var desde = new Date(Date.now() - 48 * 3600 * 1000).toISOString();

  var query = db.collection("tiendas").doc(STORE_ID)
    .collection("pedidos")
    .where("fecha", ">=", desde)
    .orderBy("fecha", "desc");

  _unsubPedidos = query.onSnapshot(
    function(snap){
      setConexion(true);
      var nuevosIds = [];

      if(!_primeraCarga){
        snap.docChanges().forEach(function(change){
          if(change.type === "added"){
            var d = change.doc.data();
            if(d.estado === "nuevo") nuevosIds.push(d.id || change.doc.id);
          }
        });
      }

      _pedidos = snap.docs.map(function(doc){
        var d = doc.data();
        d._docId = doc.id;
        if(!d.id) d.id = doc.id;
        return d;
      });

      _primeraCarga = false;

      if(nuevosIds.length){
        reproducirAlerta();
        vibrar();
        mostrarToast(
          "🔔 " + (nuevosIds.length === 1 ? "¡Tienes un pedido nuevo!" : "¡Tienes " + nuevosIds.length + " pedidos nuevos!"),
          null, true
        );
        // Actualizar tab badge en el título
        document.title = "(" + contarPorEstado("nuevo") + ") Pedidos";
      }

      /* Debounce corto: si Firestore emite varios snapshots seguidos
         (común al montar la query por primera vez), esto evita
         reconstruir la lista completa decenas de veces en milisegundos. */
      clearTimeout(_renderDebounce);
      _renderDebounce = setTimeout(function(){
        renderLista();
        actualizarContadores();
      }, 30);

      // Si el detalle estaba abierto, actualizarlo
      if(_detPedido){
        var actualizado = _pedidos.find(function(p){ return p.id === _detPedido.id; });
        if(actualizado) _detPedido = actualizado;
        renderDetalle();
      }
    },
    function(err){
      setConexion(false);
      console.warn("Firestore error:", err);
      /* El error más común acá es "The query requires an index" —
         Firestore no arma consultas con where() + orderBy() en campos
         relacionados sin un índice compuesto creado de antemano. El
         propio error de Firebase trae, en err.message, un link directo
         a la consola de Firebase para crear ese índice con un clic —
         se lo mostramos al vendedor en vez de dejarlo solo con "sin
         conexión", que no explica qué pasa de verdad. */
      if(err && err.code === "failed-precondition"){
        mostrarToast("⚠️ Falta un índice de Firestore — revisá la consola del navegador para el link que lo crea", 8000, true);
      }
    }
  );

  // Detectar reconexión offline
  window.addEventListener("online",  function(){ setConexion(true);  });
  window.addEventListener("offline", function(){ setConexion(false); });
}

/* ══════════════════════════════════════════════════════════════
   FILTRAR Y RENDERIZAR LISTA
══════════════════════════════════════════════════════════════ */
function pedidosFiltrados(){
  var lista = _pedidos.slice();

  // Filtro por tab
  if(_tabActiva !== "todos"){
    lista = lista.filter(function(p){ return p.estado === _tabActiva; });
  }

  // Filtro por búsqueda
  if(_busqueda){
    var q = _busqueda.toLowerCase();
    lista = lista.filter(function(p){
      var id     = String(p.id || "").toLowerCase();
      var nombre = String((p.cliente && p.cliente.nombre) || "").toLowerCase();
      return id.includes(q) || nombre.includes(q);
    });
  }

  // Ordenar: nuevos siempre primero
  lista.sort(function(a, b){
    if(a.estado === "nuevo" && b.estado !== "nuevo") return -1;
    if(b.estado === "nuevo" && a.estado !== "nuevo") return  1;
    return new Date(b.fecha) - new Date(a.fecha);
  });

  return lista;
}

function renderLista(){
  var lista  = pedidosFiltrados();
  var wrap   = qs("#listWrap");
  var empty  = qs("#emptyState");

  if(!lista.length){
    // Limpiar cards existentes (no el emptyState)
    Array.from(wrap.children).forEach(function(el){
      if(el.id !== "emptyState") el.remove();
    });
    empty.classList.remove("oculto");
    return;
  }
  empty.classList.add("oculto");

  /* Construir todas las cards en un fragmento en memoria primero —
     evita que el navegador pinte el layout (altura de las cards)
     antes de que el texto interno termine de insertarse, que es
     lo que causaba el efecto de "barras vacías" al recargar con
     muchos pedidos. */
  var frag = document.createDocumentFragment();
  lista.forEach(function(ped){
    var card = document.createElement("div");
    var tieneAccion = btnEstadoTxt(ped.estado) !== null;
    card.className = "ped-card" +
      (ped.estado === "nuevo" ? " estado-nuevo" : "") +
      (tieneAccion ? "" : " sin-acciones");
    card.dataset.id = ped.id;
    card.innerHTML = cardHTML(ped);
    frag.appendChild(card);
  });

  // Limpiar cards existentes (no el emptyState) y volcar el fragmento ya completo de una sola vez
  Array.from(wrap.children).forEach(function(el){
    if(el.id !== "emptyState") el.remove();
  });
  wrap.appendChild(frag);
  aplicarIconosGlobal(wrap); // solo sobre lo que se acaba de insertar, no toda la página
}

