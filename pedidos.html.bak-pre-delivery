/* Colores para los 7 "puntos de estado" (antes emoji de círculo de color) —
   mismos colores que ya usa el resto de la interfaz para esos estados. */
const PUNTO_COLOR = {
  "🔴": "#C62828", "🟢": "#2E7D32", "🟡": "#F9A825",
  "🔵": "#1565C0", "🟠": "#EF6C00", "🟣": "#6A1B9A", "⚪": "#9E9E9E"
};
const SVG_PUNTO = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" fill="currentColor"/></svg>`;

/* ══════════════════════════════════════════════════════════════
   REEMPLAZO DE EMOJI POR ÍCONOS SVG
   Reemplaza en el propio HTML fuente (antes de insertarlo al DOM)
   todo emoji del mapa por un <span> con el SVG correspondiente. Se
   aplica sobre STRINGS de HTML ya armados (los que arman las
   funciones render*), no sobre el DOM ya insertado — evitando así
   tener que recorrer nodos de texto después de cada render, que es
   más lento y más frágil con contenido que se regenera seguido
   (listas de pedidos, timeline, etc).
   Uso: envolver el string final de cualquier función que arme HTML
   con emoji con reemplazarEmojis(html) antes de asignarlo a
   innerHTML. ══════════════════════════════════════════════════════════════ */
function reemplazarEmojis(html){
  if (!html) return html;
  let out = html;
  for (const emoji in EMOJI_A_ICONO){
    if (out.indexOf(emoji) === -1) continue;
    const span = '<span class="ico-inline">' + EMOJI_A_ICONO[emoji] + '</span>';
    out = out.split(emoji).join(span);
  }
  for (const emoji in PUNTO_COLOR){
    if (out.indexOf(emoji) === -1) continue;
    const span = '<span class="ico-inline" style="color:' + PUNTO_COLOR[emoji] + '">' + SVG_PUNTO + '</span>';
    out = out.split(emoji).join(span);
  }
  return out;
}

/* Recorre TODOS los nodos de texto del contenedor dado (o de todo el
   body si no se especifica uno), saltando SCRIPT/STYLE, y reemplaza
   solo los nodos que contienen un emoji del mapa. A diferencia de
   reescribir innerHTML de bloques completos, esto no reconstruye el
   DOM alrededor (no rompe el foco de un input, no pierde el estado de
   scroll) y es seguro de llamar tantas veces como haga falta — un nodo
   ya convertido no tiene más emoji, así que una segunda pasada no hace
   nada sobre él. */
function aplicarIconosGlobal(raiz){
  try {
    const contenedor = raiz || document.body;
    const walker = document.createTreeWalker(contenedor, NodeFilter.SHOW_TEXT, {
      acceptNode: function(nodo){
        const padreTag = nodo.parentElement ? nodo.parentElement.tagName : "";
        if (padreTag === "SCRIPT" || padreTag === "STYLE") return NodeFilter.FILTER_REJECT;
        return NodeFilter.FILTER_ACCEPT;
      }
    });
    const nodosATocar = [];
    let nodo;
    while ((nodo = walker.nextNode())){
      if (tieneAlgunEmoji(nodo.nodeValue)) nodosATocar.push(nodo);
    }
    nodosATocar.forEach(function(textNode){
      const html = reemplazarEmojis(escaparParaHtml(textNode.nodeValue));
      const span = document.createElement("span");
      span.innerHTML = html;
      textNode.parentNode.replaceChild(span, textNode);
      while (span.firstChild) span.parentNode.insertBefore(span.firstChild, span);
      span.parentNode.removeChild(span);
    });
  } catch(e){ console.warn("No se pudieron aplicar los íconos:", e); }
}
function escaparParaHtml(s){
  return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}
function tieneAlgunEmoji(texto){
  if (!texto) return false;
  for (const e in EMOJI_A_ICONO) if (texto.indexOf(e) !== -1) return true;
  for (const e in PUNTO_COLOR) if (texto.indexOf(e) !== -1) return true;
  return false;
}


function fmtPrecio(n){
  return "$" + Number(n||0).toLocaleString("es-CL");
}

function fmtFecha(iso){
  if(!iso) return "—";
  var d = new Date(iso);
  var dias = ["Dom","Lun","Mar","Mié","Jue","Vie","Sáb"];
  var meses = ["Ene","Feb","Mar","Abr","May","Jun","Jul","Ago","Sep","Oct","Nov","Dic"];
  return dias[d.getDay()] + " " + d.getDate() + " " + meses[d.getMonth()] +
         ", " + String(d.getHours()).padStart(2,"0") + ":" + String(d.getMinutes()).padStart(2,"0");
}

function fmtTiempo(iso){
  if(!iso) return "";
  var diff = Date.now() - new Date(iso).getTime();
  var min  = Math.floor(diff / 60000);
  if(min < 1)  return "ahora";
  if(min < 60) return "hace " + min + " min";
  var h = Math.floor(min/60);
  return "hace " + h + "h " + (min%60) + "m";
}

function labelEstado(e){
  return {nuevo:"Nuevo",preparacion:"Preparando",camino:"En camino",listo:"Listo",cancelado:"Cancelado"}[e] || e;
}

function dotClass(e){
  return "dot-" + (e||"cancelado");
}

function badgeClass(e){
  return "badge-" + (e||"cancelado");
}

function resumenItems(items){
  if(!items || !items.length) return "Sin productos";
  return items.map(function(it){ return it.cantidad + "× " + it.nombre; }).join(", ");
}

function esc(s){
  return String(s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}

function mostrarToast(msg, dur, urgente){
  var t = qs("#toast");
  t.textContent = msg;
  t.classList.toggle("toast-urgente", !!urgente);
  t.classList.add("mostrar");
  aplicarIconosGlobal(t);
  clearTimeout(t._timer);
  t._timer = setTimeout(function(){ t.classList.remove("mostrar"); }, dur || (urgente ? 4500 : 2500));
}

/* ══════════════════════════════════════════════════════════════
   SONIDO DE ALERTA (Web Audio API — sin archivos externos)
══════════════════════════════════════════════════════════════ */
function reproducirAlerta(){
  if(!_sonidoActivo) return;
  try{
    if(!_audCtx) _audCtx = new (window.AudioContext || window.webkitAudioContext)();
    // Tres notas ascendentes cortas
    var tiempos = [0, 0.15, 0.3];
    var freqs   = [440, 554, 659];
    tiempos.forEach(function(t, i){
      var osc  = _audCtx.createOscillator();
      var gain = _audCtx.createGain();
      osc.connect(gain);
      gain.connect(_audCtx.destination);
      osc.frequency.value = freqs[i];
      osc.type = "sine";
      gain.gain.setValueAtTime(0, _audCtx.currentTime + t);
      gain.gain.linearRampToValueAtTime(0.35, _audCtx.currentTime + t + 0.04);
      gain.gain.linearRampToValueAtTime(0, _audCtx.currentTime + t + 0.14);
      osc.start(_audCtx.currentTime + t);
      osc.stop(_audCtx.currentTime + t + 0.15);
    });
  }catch(e){ /* silencioso */ }
}

function vibrar(){
  if(!_vibracionActiva) return;
  if(navigator.vibrate) navigator.vibrate([200,100,200]);
}

/* ══════════════════════════════════════════════════════════════
   CONEXIÓN / DESCONEXIÓN INDICATOR
══════════════════════════════════════════════════════════════ */
function setConexion(ok){
  var dot   = qs("#connDot");
  var label = qs("#connLabel");
  if(ok){
    dot.classList.remove("offline");
    label.textContent = "Conectado";
  } else {
    dot.classList.add("offline");
    label.textContent = "Sin conexión";
  }
}

/* ══════════════════════════════════════════════════════════════
   FIREBASE INIT
══════════════════════════════════════════════════════════════ */
async function initFirebase(){
  if(!firebase.apps.length) firebase.initializeApp(FIREBASE_CONFIG);
  db   = firebase.firestore();
  auth = firebase.auth();
  // Persistencia de sesión
  auth.setPersistence(firebase.auth.Auth.Persistence.LOCAL);

  /* Resolución de STORE_ID por dominio — mismo mecanismo que index.html.
     Si el dominio no está registrado en "dominios", se queda con el
     valor por defecto declarado más arriba (nunca rompe el panel
     actual por un dominio sin configurar). */
  try {
    const domDoc = await db.collection("dominios").doc(location.hostname).get();
    if (domDoc.exists && domDoc.data().storeId) {
      STORE_ID = domDoc.data().storeId;
    }
  } catch(e) {
    console.warn("No se pudo resolver STORE_ID por dominio, se usa el valor por defecto:", e);
  }
}

/* ══════════════════════════════════════════════════════════════
   AUTH
══════════════════════════════════════════════════════════════ */
function arrancarAuth(){
  auth.onAuthStateChanged(function(user){
    qs("#cargando").classList.add("oculto");
    if(user){
      /* Login estándar de devmode — cualquier cuenta autenticada entra.
         La protección de lo sensible (cupones, precios, caja) no vive
         acá, vive en index.html con la reautenticación de propietario
         (ver pedirVerificacionPropietario en index.html), que pide una
         segunda clave separada solo para esas acciones puntuales. */
      mostrarApp(user);
    } else {
      mostrarLogin("");
    }
  });
}

function mostrarLogin(err){
  qs("#loginScreen").classList.remove("oculto");
  qs("#app").classList.add("oculto");
  if(err) qs("#loginErr").textContent = err;
