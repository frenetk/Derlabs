/* ══════════════════════════════════════════════════════════════
   AVANZAR ESTADO
══════════════════════════════════════════════════════════════ */
function avanzarEstado(ped){
  var sig = estadoSiguiente(ped.estado);
  if(!sig) return;

  var update = { estado: sig };
  update["estadoTimeline." + sig] = new Date().toISOString();

  db.collection("tiendas").doc(STORE_ID)
    .collection("pedidos").doc(ped._docId)
    .update(update)
    .then(function(){
      mostrarToast("✅ " + ped.id + " → " + labelEstado(sig));
    })
    .catch(function(err){
      mostrarToast("❌ Error al actualizar");
      console.error(err);
    });
}

/* ══════════════════════════════════════════════════════════════
   ELIMINAR PEDIDO
══════════════════════════════════════════════════════════════ */
function eliminarPedido(ped){
  if(!ped || !ped._docId) return;
  var confirmado = confirm("¿Eliminar el pedido " + ped.id + "?\n\nEsta acción no se puede deshacer.");
  if(!confirmado) return;

  db.collection("tiendas").doc(STORE_ID)
    .collection("pedidos").doc(ped._docId)
    .delete()
    .then(function(){
      mostrarToast("🗑️ Pedido " + ped.id + " eliminado");
      cerrarDetalle();
    })
    .catch(function(err){
      mostrarToast("❌ No se pudo eliminar");
      console.error(err);
    });
}

