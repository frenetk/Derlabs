function btnEstadoTxt(e){
  if(e === "nuevo")       return "▶ PREPARAR AHORA";
  if(e === "preparacion") return "🚴 DESPACHAR";
  if(e === "camino")      return "✅ ENTREGADO";
  return null; // listo o cancelado no tienen botón
}

function btnEstadoCls(e){
  if(e === "nuevo")       return "nuevo";
  if(e === "preparacion") return "preparacion";
  if(e === "camino")      return "camino";
  return "";
}

function estadoSiguiente(e){
  if(e === "nuevo")       return "preparacion";
  if(e === "preparacion") return "camino";
  if(e === "camino")      return "listo";
  return null;
}

/* ══════════════════════════════════════════════════════════════
   CONTADORES DE TABS
══════════════════════════════════════════════════════════════ */
function contarPorEstado(e){
  return _pedidos.filter(function(p){ return p.estado === e; }).length;
}

function actualizarContadores(){
  var estados = ["nuevo","preparacion","camino","listo"];
  estados.forEach(function(e){
    var el = qs("#cnt" + (e.charAt(0).toUpperCase() + e.slice(1)));
    if(!el) return;
    var cnt = contarPorEstado(e);
    el.textContent = cnt;
    if(cnt > 0){
      el.classList.remove("oculto");
    } else {
      if(e !== "nuevo") el.classList.add("oculto");
    }
  });
}

