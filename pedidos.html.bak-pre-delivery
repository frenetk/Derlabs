/* ══════════════════════════════════════════════════════════════
   LIMPIEZA DE PREFERENCIAS DE PAGO VENCIDAS
   Respaldo del lado del cliente para cuando la scheduled function
   de Netlify (limpiarPendientes.js) no está disponible — las
   scheduled functions requieren plan Pro o superior; en el plan
   gratuito nunca se ejecutan solas. Esto corre cada vez que alguien
   abre pedidos.html, y se repite cada 5 minutos mientras la pestaña
   quede abierta (ver el setInterval al final del archivo).
══════════════════════════════════════════════════════════════ */
/* ══════════════════════════════════════════════════════════════
   LIMPIEZA DE INTENTOS DE PAGO VENCIDOS
   Respaldo del lado del cliente para cuando la scheduled function
   de Netlify (limpiarPendientes.js) no está disponible — las
   scheduled functions requieren plan Pro o superior; en el plan
   gratuito nunca se ejecutan solas. Esto corre cada vez que alguien
   abre pedidos.html, y se repite cada 5 minutos mientras la pestaña
   quede abierta (ver el setInterval al final del archivo).

   Solo borra los que quedaron en "iniciado" (el cliente probablemente
   cerró el checkout sin pagar, caso normal) — nunca los que están en
   "error", esos se dejan para que el dueño los revise en devmode
   (tab Pagos → "Intentos de pago sin confirmar").
══════════════════════════════════════════════════════════════ */
function limpiarPendientesVencidos(){
  if(!db) return;
  var MINUTOS_LIMITE = 30; // más margen que antes: un intento "iniciado" no implica que haya fallado nada, solo que el cliente no completó el pago todavía
  var limite = new Date(Date.now() - MINUTOS_LIMITE * 60 * 1000).toISOString();

  db.collection("tiendas").doc(STORE_ID).collection("intentos_pago")
    .where("estado", "==", "iniciado")
    .where("creadoEn", "<", limite)
    .get()
    .then(function(snap){
      if(snap.empty) return;
      var batch = db.batch();
      snap.docs.forEach(function(doc){ batch.delete(doc.ref); });
      return batch.commit().then(function(){
        console.log("🗑️ Limpieza: " + snap.size + " intento(s) de pago sin completar");
      });
    })
    .catch(function(e){ console.warn("limpiarPendientesVencidos:", e); });
}

