<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#111111">
<meta name="color-scheme" content="dark">
<meta name="supported-color-schemes" content="dark">
<title>Pedidos — Gestión</title>
<!-- manifest.json se genera dinámicamente por dominio, ver
     netlify/functions/manifestTienda.js y el redirect en netlify.toml.
     start_url apunta acá mismo (pedidos.html) — el acceso directo del
     celular abre directo el gestor, no la tienda pública. -->
<link rel="manifest" href="/manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet">

<!-- Firebase compat SDK v9 -->
<script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-firestore-compat.js"></script>

<style>
/* ══════════════════════════════════════
   TOKENS & RESET
══════════════════════════════════════ */
:root{
  color-scheme: dark;
  --rojo:#E53935;
  --rojo-dark:#B71C1C;
  --naranja:#F57C00;
  --azul:#1565C0;
  --verde:#2E7D32;
  --verde-light:#43A047;
  --bg:#0E0E0E;
  --bg2:#181818;
  --bg3:#222222;
  --card:#1E1E1E;
  --borde:rgba(255,255,255,.08);
  --txt:#F5F5F5;
  --txt2:#A0A0A0;
  --txt3:#606060;
  --header-h:56px;
  --tabs-h:48px;
  --radius:16px;
  --shadow:0 4px 20px rgba(0,0,0,.45);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
.ico-inline{
  display:inline-flex;align-items:center;justify-content:center;
  width:1em;height:1em;vertical-align:-0.14em;
  flex-shrink:0;
}
.ico-inline svg{width:100%;height:100%;display:block}
html{color-scheme:dark}
html,body{
  height:100%;
  background:var(--bg);color:var(--txt);font-family:'Nunito',sans-serif;
  overflow:hidden;
  position:fixed;
  inset:0;
  width:100%;
}
button{font-family:'Nunito',sans-serif;cursor:pointer;border:none;outline:none;color:inherit}
input{font-family:'Nunito',sans-serif;outline:none;border:none;color:var(--txt);background-color:transparent;color-scheme:dark}
a{color:inherit;text-decoration:none}

/* ══════════════════════════════════════
   PANTALLA DE LOGIN
══════════════════════════════════════ */
#loginScreen{
  position:fixed;inset:0;background:var(--bg);
  display:flex;align-items:center;justify-content:center;
  padding:24px;z-index:1000;
}
.login-box{
  width:100%;max-width:360px;
  background:var(--card);border-radius:24px;
  padding:36px 28px 32px;
  box-shadow:0 12px 48px rgba(0,0,0,.6);
}
.login-logo{
  text-align:center;margin-bottom:28px;
}
.login-logo svg{width:48px;height:48px;color:var(--rojo)}
.login-logo h1{
  font-family:'Barlow Condensed',sans-serif;
  font-size:28px;font-weight:800;letter-spacing:1px;
  margin-top:10px;color:var(--txt);
}
.login-logo p{font-size:13px;color:var(--txt2);margin-top:4px}
.login-field{margin-bottom:14px}
.login-field label{
  display:block;font-size:12px;font-weight:700;
  color:var(--txt2);margin-bottom:6px;letter-spacing:.5px;text-transform:uppercase;
}
.login-field input{
  width:100%;background:var(--bg3);
  border:1.5px solid var(--borde);border-radius:10px;
  padding:13px 14px;font-size:15px;color:var(--txt);
  transition:border-color .2s;
}
.login-field input:focus{border-color:var(--rojo)}
.login-err{
  font-size:13px;color:#EF5350;font-weight:700;
  text-align:center;margin-bottom:12px;min-height:18px;
}
.btn-login{
  width:100%;padding:15px;border-radius:12px;
  background:var(--rojo);color:#fff;
  font-size:16px;font-weight:800;letter-spacing:.5px;
  transition:opacity .15s,transform .1s;
}
.btn-login:active{opacity:.85;transform:scale(.98)}
.btn-login:disabled{opacity:.5;pointer-events:none}

/* ══════════════════════════════════════
   LAYOUT PRINCIPAL
══════════════════════════════════════ */
#app{
  display:flex;flex-direction:column;
  position:fixed;
  inset:0;
  max-width:600px;margin:0 auto;
  overflow:hidden;
}
#app.oculto{display:none}

/* HEADER */
#header{
  flex-shrink:0;
  height:var(--header-h);
  background:var(--bg2);
  border-bottom:1px solid var(--borde);
  display:flex;align-items:center;
  padding:0 16px;gap:10px;
  position:relative;z-index:10;
  isolation:isolate;
}
.h-brand{
  display:flex;align-items:center;gap:8px;flex:1;min-width:0;
}
.h-brand-ico{
  width:32px;height:32px;background:var(--rojo);
  border-radius:8px;display:flex;align-items:center;justify-content:center;
  flex-shrink:0;
}
.h-brand-ico svg{width:18px;height:18px;color:#fff}
.h-title{
  font-family:'Barlow Condensed',sans-serif;
  font-size:20px;font-weight:800;letter-spacing:.5px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  color:var(--txt);
}
#conexionIndicador{
  display:flex;align-items:center;gap:6px;
  font-size:12px;font-weight:700;color:var(--txt2);
  flex-shrink:0;
}
.conn-dot{
  width:8px;height:8px;border-radius:50%;
  background:var(--verde-light);
  transition:background .3s;
}
.conn-dot.offline{
  background:var(--rojo);
  animation:parpadeo 1s ease-in-out infinite;
}
@keyframes parpadeo{0%,100%{opacity:1}50%{opacity:.3}}
.conn-label{display:none}
@media(min-width:380px){.conn-label{display:inline}}

.btn-settings{
  width:36px;height:36px;border-radius:10px;
  background:var(--bg3);
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;
}
.btn-settings svg{width:18px;height:18px;color:var(--txt2)}

/* TABS */
#tabs{
  flex-shrink:0;
  height:var(--tabs-h);
  background:var(--bg2);
  border-bottom:1px solid var(--borde);
  display:flex;overflow-x:auto;scrollbar-width:none;
  padding:0 8px;gap:2px;
}
#tabs::-webkit-scrollbar{display:none}
.tab-btn{
  flex-shrink:0;height:100%;
  padding:0 14px;
  display:flex;align-items:center;gap:6px;
  font-size:13px;font-weight:700;color:var(--txt2);
  border-bottom:2.5px solid transparent;
  transition:color .15s,border-color .15s;
  white-space:nowrap;background:transparent;
}
.tab-btn.activo{color:var(--txt);border-bottom-color:var(--rojo)}
.tab-cnt{
  background:var(--rojo);color:#fff;
  font-size:10px;font-weight:900;
  padding:1px 6px;border-radius:20px;
  min-width:18px;text-align:center;line-height:16px;
}
.tab-cnt.oculto{display:none}

/* BUSCADOR */
#searchBar{
  flex-shrink:0;
  padding:10px 14px;
  background:var(--bg);
  border-bottom:1px solid var(--borde);
}
.search-wrap{
  display:flex;align-items:center;gap:8px;
  background:var(--bg3);border-radius:10px;
  padding:0 12px;
}
.search-wrap svg{width:16px;height:16px;color:var(--txt3);flex-shrink:0}
#searchInput{
  flex:1;background:transparent;
  padding:10px 0;font-size:14px;font-weight:600;
  color:var(--txt);
}
#searchInput::placeholder{color:var(--txt3)}

/* LISTA DE PEDIDOS */
#listWrap{
  flex:1;min-height:0;overflow-y:auto;
  -webkit-overflow-scrolling:touch;
  overscroll-behavior:contain;
  touch-action:pan-y;
  padding:12px 14px 24px;
  display:flex;flex-direction:column;gap:10px;
  position:relative;z-index:1;
}
#listWrap::-webkit-scrollbar{width:4px}
#listWrap::-webkit-scrollbar-thumb{background:var(--bg3);border-radius:2px}

/* ESTADO VACÍO */
#emptyState{
  flex:1;display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  gap:12px;padding:40px 20px;text-align:center;
}
.empty-ico{font-size:48px;line-height:1}
.empty-tit{font-size:16px;font-weight:800;color:var(--txt2)}
.empty-sub{font-size:13px;color:var(--txt3);font-weight:600}

/* ══════════════════════════════════════
   CARDS DE PEDIDO
══════════════════════════════════════ */
.ped-card{
  background:var(--card);border-radius:var(--radius);
  border:1.5px solid var(--borde);
  cursor:pointer;
  transition:border-color .15s,transform .1s;
  -webkit-user-select:none;user-select:none;
  touch-action:pan-y;
}
.ped-card:active{transform:scale(.99)}
.ped-card.estado-nuevo{
  border-color:var(--rojo);
  animation:pulso-borde 2s ease-in-out infinite;
}
@keyframes pulso-borde{
  0%,100%{box-shadow:0 0 0 0 rgba(229,57,53,.4)}
  50%{box-shadow:0 0 0 6px rgba(229,57,53,0)}
}

.card-head{
  padding:12px 14px 10px;
  display:flex;align-items:center;gap:10px;
}
.card-estado-dot{
  width:10px;height:10px;border-radius:50%;flex-shrink:0;
}
.dot-nuevo{background:var(--rojo)}
.dot-preparacion{background:var(--naranja)}
.dot-camino{background:var(--azul)}
.dot-listo{background:var(--verde)}
.dot-cancelado{background:var(--txt3)}

.card-id{
  font-family:'Barlow Condensed',sans-serif;
  font-size:17px;font-weight:800;letter-spacing:.5px;
  flex:1;color:var(--txt);
}
.card-badge{
  font-size:10px;font-weight:900;padding:3px 9px;border-radius:20px;
  text-transform:uppercase;letter-spacing:.5px;
}
.badge-nuevo{background:rgba(229,57,53,.15);color:var(--rojo)}
.badge-preparacion{background:rgba(245,124,0,.15);color:var(--naranja)}
.badge-camino{background:rgba(21,101,192,.15);color:#64B5F6}
.badge-listo{background:rgba(46,125,50,.15);color:#81C784}
.badge-cancelado{background:rgba(96,96,96,.15);color:var(--txt3)}

.card-meta{
  padding:0 14px 10px;
  display:flex;align-items:center;gap:8px;
  font-size:12px;color:var(--txt2);font-weight:600;
}
.card-tiempo{color:var(--txt2)}
.card-tipo-ico{font-size:12px}
.card-sep{color:var(--txt3)}

.card-cliente{
  padding:0 14px 8px;
  font-size:14px;font-weight:800;color:var(--txt);
}
.card-cliente span{font-weight:600;color:var(--txt2);font-size:13px}

.card-items{
  padding:0 14px 8px;
  font-size:13px;color:var(--txt2);font-weight:600;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}

.card-dir{
  padding:0 14px 8px;
  font-size:12px;color:var(--txt3);font-weight:600;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}

.card-footer{
  padding:10px 14px 12px;
  display:flex;align-items:center;gap:8px;
  border-top:1px solid var(--borde);
}
/* Cuando la card no tiene botón de acción (estado listo/cancelado),
   el footer usa más padding para igualar la altura de las demás cards.
   Sin esto, la mezcla de alturas distintas en el mismo listado flex
   puede provocar que el navegador recorte visualmente el contenido
   de las cards más cortas durante el reflow inicial en móvil. */
.ped-card.sin-acciones .card-footer{
  padding-bottom:26px;
}
.card-total{
  flex:1;font-size:16px;font-weight:900;color:var(--txt);
}
.card-pago{
  font-size:11px;font-weight:700;color:var(--txt2);
  background:var(--bg3);padding:4px 8px;border-radius:8px;
}

/* Botones de acción en card */
.card-acciones{
  padding:10px 14px 14px;
  display:flex;gap:8px;
}
.btn-estado{
  flex:1;padding:12px 8px;border-radius:12px;
  font-size:14px;font-weight:900;color:#fff;
  letter-spacing:.3px;
  transition:opacity .15s,transform .1s;
}
.btn-estado:active{opacity:.85;transform:scale(.98)}
.btn-estado.nuevo{background:var(--rojo)}
.btn-estado.preparacion{background:var(--naranja)}
.btn-estado.camino{background:var(--verde)}

.btn-wa{
  width:46px;height:46px;border-radius:12px;flex-shrink:0;
  background:#25D366;
  display:flex;align-items:center;justify-content:center;
}
.btn-wa svg{width:22px;height:22px;color:#fff}

/* ══════════════════════════════════════
   PANEL DE DETALLE (DRAWER)
══════════════════════════════════════ */
#detalle{
  position:fixed;inset:0;z-index:200;
  display:flex;flex-direction:column;
}
#detalle.oculto{display:none}
.det-overlay{
  position:absolute;inset:0;
  background:rgba(0,0,0,.65);backdrop-filter:blur(3px);
}
.det-panel{
  position:absolute;bottom:0;left:0;right:0;
  max-width:600px;margin:0 auto;
  background:var(--bg2);
  border-radius:20px 20px 0 0;
  max-height:92dvh;
  display:flex;flex-direction:column;
  animation:slideUp .25s ease;
}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.det-handle{
  width:36px;height:4px;border-radius:2px;
  background:var(--bg3);margin:10px auto 0;flex-shrink:0;
}
.det-header{
  padding:14px 18px 12px;
  display:flex;align-items:center;gap:10px;
  border-bottom:1px solid var(--borde);
  flex-shrink:0;
}
.det-id{
  font-family:'Barlow Condensed',sans-serif;
  font-size:22px;font-weight:800;flex:1;color:var(--txt);
}
.det-close{
  width:32px;height:32px;border-radius:8px;
  background:var(--bg3);
  display:flex;align-items:center;justify-content:center;
}
.det-close svg{width:16px;height:16px;color:var(--txt2)}

.det-body{
  flex:1;overflow-y:auto;padding:16px 18px 24px;
  display:flex;flex-direction:column;gap:16px;
}
.det-body::-webkit-scrollbar{width:3px}
.det-body::-webkit-scrollbar-thumb{background:var(--bg3)}

.det-section{
  background:var(--bg3);border-radius:12px;padding:14px;
}
.det-section-tit{
  font-size:11px;font-weight:800;letter-spacing:1px;
  text-transform:uppercase;color:var(--txt3);margin-bottom:10px;
}
.det-mapa-mini{
  width:100%;height:150px;border-radius:10px;overflow:hidden;
  margin-bottom:12px;background:var(--bg2);border:1px solid rgba(255,255,255,.06);
}
.det-mapa-mini iframe{width:100%;height:100%;border:0;display:block}
.det-row{
  display:flex;align-items:flex-start;gap:10px;
  padding:5px 0;font-size:14px;
}
.det-row:not(:last-child){border-bottom:1px solid rgba(255,255,255,.05)}
.det-row-ico{
  width:20px;height:20px;flex-shrink:0;margin-top:1px;
}
.det-row-ico svg{width:100%;height:100%;color:var(--txt3)}
.det-row-lbl{flex:1;font-weight:600;color:var(--txt2);font-size:13px}
.det-row-val{font-weight:700;color:var(--txt);text-align:right}
.det-row-val a{color:#64B5F6}

/* Items del pedido */
.det-items{}
.det-item{
  display:flex;align-items:flex-start;gap:8px;
  padding:6px 0;font-size:14px;
}
.det-item:not(:last-child){border-bottom:1px solid rgba(255,255,255,.05)}
.det-item-cant{
  min-width:24px;height:24px;border-radius:6px;
  background:rgba(229,57,53,.15);color:var(--rojo);
  font-size:12px;font-weight:900;
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;
}
.det-item-nom{flex:1;font-weight:700;color:var(--txt)}
.det-item-extra{
  font-weight:600;font-size:12.5px;color:var(--txt2);
  margin-top:2px;line-height:1.4;
}
.det-item-nota{font-style:italic}
.det-item-precio{font-weight:700;color:var(--txt2);font-size:13px;flex-shrink:0}

/* Totales */
.det-totales{}
.det-total-row{
  display:flex;justify-content:space-between;
  align-items:center;padding:5px 0;
  font-size:14px;font-weight:600;color:var(--txt2);
}
.det-total-row.principal{
  font-size:17px;font-weight:900;color:var(--txt);
  border-top:1px solid var(--borde);margin-top:6px;padding-top:10px;
}
.det-total-row.descuento{color:#81C784}

/* Timeline */
.timeline{}
.tl-item{
  display:flex;align-items:flex-start;gap:12px;
  padding-bottom:14px;position:relative;
}
.tl-item:not(:last-child)::before{
  content:"";position:absolute;left:9px;top:20px;
  width:2px;bottom:0;background:var(--borde);
}
.tl-dot{
  width:20px;height:20px;border-radius:50%;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  font-size:10px;z-index:1;
}
.tl-dot.hecho{background:var(--verde);color:#fff}
.tl-dot.pendiente{background:var(--bg);border:2px solid var(--borde)}
.tl-dot.pendiente svg{width:10px;height:10px;color:var(--txt3)}
.tl-info{flex:1}
.tl-label{font-size:13px;font-weight:800;color:var(--txt)}
.tl-ts{font-size:11px;font-weight:600;color:var(--txt3);margin-top:2px}

/* Botones detalle */
.det-acciones{
  display:flex;gap:8px;flex-shrink:0;
  padding:0 18px 16px;
}
.det-acciones .btn-estado{padding:14px}
.det-btn-wa{
  flex-shrink:0;width:50px;height:50px;border-radius:12px;
  background:#25D366;
  display:flex;align-items:center;justify-content:center;
}
.det-btn-wa svg{width:24px;height:24px;color:#fff}
.det-btn-maps{
  flex-shrink:0;width:50px;height:50px;border-radius:12px;
  background:var(--bg3);
  display:flex;align-items:center;justify-content:center;
}
.det-btn-maps svg{width:22px;height:22px;color:#64B5F6}
.det-btn-eliminar{
  flex-shrink:0;width:50px;height:50px;border-radius:12px;
  background:rgba(229,57,53,.12);
  display:flex;align-items:center;justify-content:center;
}
.det-btn-eliminar svg{width:22px;height:22px;color:var(--rojo)}

/* ══════════════════════════════════════
   PANEL DE SETTINGS
══════════════════════════════════════ */
#settings{
  position:fixed;inset:0;z-index:300;
  display:flex;align-items:flex-end;justify-content:center;
}
#settings.oculto{display:none}
.set-overlay{position:absolute;inset:0;background:rgba(0,0,0,.65)}
.set-panel{
  position:relative;width:100%;max-width:600px;
  background:var(--bg2);border-radius:20px 20px 0 0;
  padding:16px 20px calc(20px + env(safe-area-inset-bottom,0px));
  animation:slideUp .2s ease;
}
.set-tit{
  font-family:'Barlow Condensed',sans-serif;
  font-size:20px;font-weight:800;margin-bottom:16px;
  color:var(--txt);
}
.set-row{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 0;border-bottom:1px solid var(--borde);
}
.set-row:last-of-type{border-bottom:none}
.set-row-lbl{font-size:14px;font-weight:700;color:var(--txt)}
.set-row-sub{font-size:12px;color:var(--txt2);font-weight:600;margin-top:2px}
/* Toggle switch */
.toggle{position:relative;width:44px;height:26px;flex-shrink:0}
.toggle input{opacity:0;width:0;height:0}
.toggle-slider{
  position:absolute;inset:0;border-radius:13px;
  background:var(--bg3);cursor:pointer;
  transition:background .2s;
}
.toggle-slider::before{
  content:"";position:absolute;left:3px;top:3px;
  width:20px;height:20px;border-radius:50%;
  background:#fff;transition:transform .2s;
}
.toggle input:checked + .toggle-slider{background:var(--verde-light)}
.toggle input:checked + .toggle-slider::before{transform:translateX(18px)}

.btn-logout{
  width:100%;padding:14px;border-radius:12px;
  background:rgba(229,57,53,.12);color:var(--rojo);
  font-size:15px;font-weight:800;margin-top:16px;
  transition:background .15s;
}
.btn-logout:active{background:rgba(229,57,53,.2)}

.set-row-full{padding:14px 0;border-bottom:1px solid var(--borde)}
.btn-ir-devmode{
  display:block;text-align:center;padding:13px;border-radius:12px;
  background:rgba(229,57,53,.1);color:var(--rojo);
  font-size:14px;font-weight:800;transition:background .15s;
}
.btn-ir-devmode:active{background:rgba(229,57,53,.18)}

/* ══════════════════════════════════════
   TOAST / NOTIF
══════════════════════════════════════ */
#toast{
  position:fixed;top:calc(var(--header-h) + var(--tabs-h) + 10px);
  left:50%;
  background:var(--card);border:1px solid var(--borde);color:var(--txt);
  padding:12px 20px;border-radius:14px;
  font-size:14px;font-weight:700;
  box-shadow:var(--shadow);z-index:950;
  pointer-events:none;
  white-space:nowrap;
  display:flex;align-items:center;gap:8px;
  transform:translateX(-50%) translateY(-16px);
  opacity:0;
  transition:transform .25s ease, opacity .25s ease;
}
#toast.mostrar{
  transform:translateX(-50%) translateY(0);
  opacity:1;
}
#toast.toast-urgente{
  background:var(--rojo);color:#fff;border-color:transparent;
  font-size:16px;padding:15px 24px;
  box-shadow:0 6px 26px rgba(229,57,53,.5);
  animation:toast-pulso 1.4s ease-in-out 2;
}
@keyframes toast-pulso{
  0%,100%{box-shadow:0 6px 26px rgba(229,57,53,.5)}
  50%{box-shadow:0 6px 34px rgba(229,57,53,.85)}
}

/* ══════════════════════════════════════
   CARGANDO
══════════════════════════════════════ */
#cargando{
  position:fixed;inset:0;background:var(--bg);
  display:flex;align-items:center;justify-content:center;
  z-index:900;
}
.spin{
  width:36px;height:36px;border-radius:50%;
  border:3px solid var(--borde);
  border-top-color:var(--rojo);
  animation:spin .7s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg)}}

